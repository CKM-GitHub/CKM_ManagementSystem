@model UserCreateViewModel
@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/UserEntry.js" asp-append-version="true"></script>
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
<link rel="stylesheet" href="~/css/UserEntry.css"/>

<div class="container d-flex justify-content-center align-items-center min-vh-100 py-5">
    <div class="card border-0 rounded-4 shadow p-5 bg-white w-100 user-entry-card">
        <h2 class="text-center fw-bold mb-5 user-entry-title">User Entry</h2>
        <form class="row g-4" method="post" asp-controller="UserEntry" asp-action="UserCreate" enctype="multipart/form-data">
            <div class="col-md-4 d-flex flex-column align-items-center border-end-md pe-md-4">
                <label class="form-label fw-semibold text-secondary mb-3">Profile Photo</label>
                <div class="d-flex flex-column align-items-center">
                    <div class="avatar-preview-circle rounded-circle border border-2 overflow-hidden d-flex align-items-center justify-content-center" style="width:130px;height:130px;">
                        <i id="default-icon" class="fa-solid fa-camera text-secondary" style="font-size:30px;"></i>
                        <img id="avatar-preview" class="w-100 h-100 object-fit-cover d-none" alt="Profile Preview">
                    </div>
                    <label for="image-upload" class="btn border border-secondary-subtle d-flex align-items-center gap-2 px-3 py-2 upload-btn mt-3 text-primary fw-bold">
                        <i class="fa-regular fa-user"></i>
                        Upload Profile
                    </label>
                    <input type="file"
                           id="image-upload"
                           asp-for="ImageFile"
                           class="d-none"
                           accept="image/*">
                </div>
                <span asp-validation-for="ImageFile" class="text-danger small"></span>
            </div>
            <div class="col-md-8 ps-md-4">
                <div class="row g-3">
                    <div class="col-12">
                        <div class="row align-items-center">
                            <label asp-for="StaffCode" class="col-sm-4 col-form-label fw-medium text-secondary"></label>
                            <div class="col-sm-8">
                                <input type="text" asp-for="StaffCode" class="form-control rounded-3 py-2" placeholder="e.g. CKM-0001">
                                <span asp-validation-for="StaffCode" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="row align-items-center">
                            <label asp-for="Name" class="col-sm-4 form-label fw-medium text-secondary mb-sm-0"></label>
                            <div class="col-sm-8">
                                <input type="text" asp-for="Name" class="form-control rounded-3 py-2" placeholder="Enter full name">
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="row align-items-center">
                            <label asp-for="Email" class="col-sm-4 form-label fw-medium text-secondary mb-sm-0"></label>
                            <div class="col-sm-8">
                                <input type="email" asp-for="Email" class="form-control rounded-3 py-2" placeholder="Enter email address">
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="row align-items-center">
                            <label asp-for="Password" class="col-sm-4 form-label fw-medium text-secondary mb-sm-0"></label>
                            <div class="col-sm-8">
                                <input type="password" asp-for="Password" class="form-control rounded-3 py-2" placeholder="Generate temporary password">
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="row align-items-center">
                            <label asp-for="ConfirmPassword" class="col-sm-4 form-label fw-medium text-secondary mb-sm-0"></label>
                            <div class="col-sm-8">
                                <input type="password" asp-for="ConfirmPassword" class="form-control rounded-3 py-2" placeholder="Confirm password">
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="row align-items-center">
                            <label class="col-sm-4 form-label fw-medium text-secondary mb-0">Gender</label>
                            <div class="col-sm-8 d-flex gap-4">
                                <div class="form-check">
                                    <input class="form-check-input gender-radio" type="radio" asp-for="Gender" value="Male" id="genderMale">
                                    <label class="form-check-label text-secondary" for="genderMale">Male</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input gender-radio-unchecked" type="radio" asp-for="Gender" value="Female" id="genderFemale">
                                    <label class="form-check-label text-secondary" for="genderFemale">Female</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="row align-items-center">
                            <label asp-for="DepartmentCode" class="col-sm-4 form-label fw-medium text-secondary mb-sm-0"></label>
                            <div class="col-sm-8">
                                <select asp-for="DepartmentCode" class="form-select rounded-3 py-2 text-secondary" asp-items="(SelectList)ViewBag.DepartmentList">
                                    <option value="">Select Department</option>
                                </select>
                                <span asp-validation-for="DepartmentCode" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="row align-items-center">
                            <label asp-for="RoleCode" class="col-sm-4 form-label fw-medium text-secondary mb-sm-0"></label>
                            <div class="col-sm-8">
                                <select asp-for="RoleCode" class="form-select rounded-3 py-2 text-secondary" asp-items="(SelectList)ViewBag.UserRoleList">
                                    <option value="">Select Role</option>
                                </select>
                                <span asp-validation-for="RoleCode" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="row align-items-center">
                            <label class="col-sm-4 form-label fw-medium text-secondary mb-0">Status</label>
                            <div class="col-sm-8 d-flex gap-4">
                                <div class="form-check">
                                    <input class="form-check-input status-radio" type="radio" asp-for="Status" value="true" id="statusActive">
                                    <label class="form-check-label text-secondary" for="statusActive">Active</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input status-radio-unchecked" type="radio" asp-for="Status" value="false" id="statusInactive">
                                    <label class="form-check-label text-secondary" for="statusInactive">Inactive</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="col-sm-8 offset-sm-4">
                            <div class="form-check">
                                <input class="form-check-input rounded-1 terms-checkbox" type="checkbox" asp-for="AcceptTerms" id="termsCheck">
                                <label class="form-check-label text-secondary small" for="termsCheck">
                                    I agree to the Terms of Service and Privacy Policy
                                </label>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="col-12 d-flex justify-content-end gap-3 mt-5 pt-3 border-top form-actions">
                <button type="button" class="btn btn-light px-4 py-2 rounded-3 fw-medium text-secondary border cancel-btn">Cancel</button>
                <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 fw-medium create-btn" id="submitBtn" disabled>Create User</button>
            </div>
        </form>
    </div>
</div>