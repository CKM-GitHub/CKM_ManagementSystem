@model CKM_ManagementSystem.Models.ViewModels.Password.ChangePasswordViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Change Password";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/ChangePassword.css"
          asp-append-version="true" />
}
@if (TempData["SuccessMessage"] is string successMessage)
{
    <input type="hidden"
           id="successMessage"
           value="@successMessage" />

    <form id="logoutForm"
          asp-controller="ChangePassword"
          asp-action="Logout"
          method="post">
        @Html.AntiForgeryToken()
    </form>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <input type="hidden"
           id="errorMessage"
           value="@errorMessage" />
}

<partial name="AlertModal" />

<div class="change-password-wrapper">
    <div class="card custom-card">
        <h4 class="text-center card-title">Change Password</h4>
        <form asp-controller="ChangePassword" asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="StaffCode" />
            <div class="form-group">
                <label asp-for="CurrentPassword" class="form-label">Old Password</label>
                <div class="input-group">
                    <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Enter Current Password" autofocus>
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>
            <div class="form-group">
                <label asp-for="NewPassword" class="form-label">New Password</label>
                <div class="input-group">
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="Enter New Password">
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm New Password">
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-3 mt-4">
                <button type="button"
                        id="cancelChangePassword"
                        class="btn btn-cancel w-50">
                    Cancel
                </button>               
                <button type="submit" class="btn btn-save w-50">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/Alert_Modal.js"
            asp-append-version="true"></script>

    <script src="~/js/ChangePassword.js"
            asp-append-version="true"></script>
}
