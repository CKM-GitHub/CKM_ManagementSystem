@model CKM_ManagementSystem.Models.ViewModels.MainMenu.MainMenuViewModel

@if (Model != null)
{
    <div class="profile-dropdown dropdown">

        <button class="profile-button"
        type="button"
        data-bs-toggle="dropdown"
        aria-expanded="false">
            @if (!string.IsNullOrWhiteSpace(Model.ImageURL))
            {
                <img src="@Model.ImageURL"
                class="profile-image"
                alt="Profile" />
            }
            else
            {
                <div class="profile-default-icon">
                    <i class="bi bi-person-fill"></i>
                </div>
            }

            <div class="profile-info">
                <span class="profile-name">@Model.UserName</span>
                <span class="profile-role">@Model.RoleName</span>
            </div>

            <i class="bi bi-chevron-down"></i>

        </button>

        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <a class="dropdown-item"
                    asp-controller="UserCreate"
                    asp-action="UserCreate"
                    asp-route-mode="Update"
                   asp-route-source="Profile"
                    asp-route-staffCode="@Model.StaffCode">
                    <i class="bi bi-person me-2"></i>
                    User Info
                </a>
            </li>
            <li>
                <a class="dropdown-item"
                   asp-controller="ChangePassword"
                   asp-action="ChangePassword">
                    <i class="bi bi-key me-2"></i>
                    Change Password
                </a>
            </li>

            <li>
                <form asp-controller="ChangePassword"
                      asp-action="Logout"
                      method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="dropdown-item logout-item">
                        <i class="bi bi-box-arrow-right me-2"></i>
                        Logout
                    </button>
                </form>
            </li>
        </ul>

    </div>
}