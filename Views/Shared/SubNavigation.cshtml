@model List<CKM_ManagementSystem.Models.ViewModels.MainMenu.MainMenuViewModel>

@{
    string currentController = ViewBag.CurrentController?.ToString() ?? "";

    string currentAction = ViewBag.CurrentAction?.ToString() ?? "";
}
@if (Model != null && Model.Count > 0)
{
    <nav class="sub-navigation">
        @foreach(var menu in Model)
        {
            bool isActive = string.Equals(
                currentController,
                menu.ControllerName,
                StringComparison.OrdinalIgnoreCase
            )
            &&
            string.Equals(
                currentAction,
                menu.ActionName,
                StringComparison.CurrentCultureIgnoreCase
            );
            <span class="sub-nav-link @(isActive ? "active" : "")">
                @menu.MenuName
            </span>
        }
    </nav>
}