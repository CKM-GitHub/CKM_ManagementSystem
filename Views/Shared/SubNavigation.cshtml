@model List<CKM_ManagementSystem.Models.ViewModels.MainMenu.MainMenuViewModel>

@if(Model != null && Model.Count > 0)
{
    <nav class="sub-navigation">
        @for (int i=0; i<Model.Count; i++)
        {
            bool isCurrentPage = i == Model.Count - 1;
            <span class="sub-nav-link @(isCurrentPage ? "active": "")">
                @Model[i].MenuName
            </span>
            @if (i < Model.Count - 1)
            {
                <span class="sub-nav-separator">
                    &gt;
                </span>
            }
        }
    </nav>
}