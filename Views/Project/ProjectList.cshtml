@using CKM_ManagementSystem.Models.ViewModels.Project
@model ProjectListPagedViewModel

@{
    ViewData["Title"] = "Project Management";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/project-list.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Alert_Modal.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/ckm-theme.css"
          asp-append-version="true" />
}

<div class="container-fluid px-4 px-md-5 pb-5">

    <h2 class="page-title">
        Project Management
    </h2>

    @Html.AntiForgeryToken()

    <div class="custom-card">

        <form method="get"
              asp-action="ProjectList"
              asp-controller="Project"
              id="projectSearchForm">

            <input type="hidden"
                   name="pageNumber"
                   value="1" />

            <div class="filter-container">

                <div class="filter-left-group">

                    <div class="search-input-group">

                        <input type="text"
                               id="searchKeyword"
                               name="searchKeyword"
                               class="form-control"
                               placeholder="Search project..."
                               value="@Model.SearchKeyword" />

                        <i class="bi bi-search search-icon"></i>

                    </div>

                    <select id="status"
                            name="status"
                            class="form-select custom-select">

                        <option value="">
                            All Statuses
                        </option>

                        <option value="Active"
                                selected="@(Model.Status == "Active")">
                            Active
                        </option>

                        <option value="Completed"
                                selected="@(Model.Status == "Completed")">
                            Completed
                        </option>

                        <option value="On Hold"
                                selected="@(Model.Status == "On Hold")">
                            On Hold
                        </option>

                        <option value="Inactive"
                                selected="@(Model.Status == "Inactive")">
                            Inactive
                        </option>

                    </select>

                    <button type="submit"
                            class="btn btn-search-menu">

                        <i class="bi bi-search me-1"></i>
                        Search Project

                    </button>

                </div>

                <div>

                    <a asp-action="Create"
                       asp-controller="Project"
                       class="btn btn-add-project">

                        <i class="bi bi-plus-lg me-1"></i>
                        Add Project

                    </a>

                </div>

            </div>

        </form>

    </div>

    <div class="custom-card">

        <div class="table-responsive">

            <table class="project-table"
                   style="table-layout: fixed; width: 100%;">

                <thead>

                    <tr>
                        <th style="width:70px;">No.</th>
                        <th style="width:140px;">Project Code</th>
                        <th style="width:190px;">Project Name</th>
                        <th style="width:170px;">Project Manager</th>
                        <th style="width:230px;">Git Repository</th>
                        <th style="width:150px;">Project Members</th>
                        <th style="width:125px;">Start Date</th>
                        <th style="width:125px;">End Date</th>
                        <th style="width:120px;">Status</th>
                        <th style="width:110px;">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model.Projects != null &&
                    Model.Projects.Any())
                    {
                        foreach (var project in Model.Projects)
                        {
                            <tr>

                                <td>
                                    @project.No
                                </td>

                                <td class="fw-medium">

                                    <span class="table-text-truncate"
                                          title="@project.ProjectCode">

                                        @project.ProjectCode

                                    </span>

                                </td>

                                <td class="fw-semibold">

                                    <span class="table-text-truncate"
                                          title="@project.ProjectName">

                                        @project.ProjectName

                                    </span>

                                </td>

                                <td>

                                    <span class="table-text-truncate"
                                          title="@project.ProjectManagerName">

                                        @project.ProjectManagerName

                                    </span>

                                </td>

                                <td>

                                    <span class="git-repo-text table-text-truncate"
                                          title="@project.GitRepositoryUrl">

                                        @(string.IsNullOrWhiteSpace(
                                            project.GitRepositoryUrl)
                                            ? "-"
                                            : project.GitRepositoryUrl)

                                    </span>

                                </td>

                                <td>
                                    @project.ProjectMemberCount
                                </td>

                                <td>
                                    @project.StartDate.ToString("yyyy-MM-dd")
                                </td>

                                <td>
                                    @project.EndDate.ToString("yyyy-MM-dd")
                                </td>

                                <td>

                                    @switch (project.Status)
                                    {
                                        case "Active":

                                            <span class="badge-status-active">
                                                Active
                                            </span>

                                            break;

                                        case "Completed":

                                            <span class="badge-status-completed">
                                                Completed
                                            </span>

                                            break;

                                        case "On Hold":

                                            <span class="badge-status-onhold">
                                                On Hold
                                            </span>

                                            break;

                                        case "Inactive":

                                            <span class="badge-status-inactive">
                                                Inactive
                                            </span>

                                            break;

                                        default:

                                            <span class="badge-status-default">
                                                @project.Status
                                            </span>

                                            break;
                                    }

                                </td>

                                <td class="action-column">

                                    <a asp-action="Edit"
                                       asp-controller="Project"
                                       asp-route-projectCode="@project.ProjectCode"
                                       class="icon-button edit-icon"
                                       title="Edit">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    <button type="button"
                                            class="icon-button delete-icon project-delete-btn"
                                            data-project-code="@project.ProjectCode"
                                            data-project-name="@project.ProjectName"
                                            title="Delete">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="10"
                                class="text-center text-muted py-4">

                                No records found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="table-footer">

            <div class="footer-text">

                @{
                    int startRecord =
                    Model.TotalRecords == 0
                    ? 0
                    : ((Model.PageNumber - 1)
                    * Model.PageSize) + 1;

                    int endRecord =
                    Model.TotalRecords == 0
                    ? 0
                    : Math.Min(
                    Model.PageNumber * Model.PageSize,
                    Model.TotalRecords);
                }

                Showing
                @startRecord-@endRecord
                of
                @Model.TotalRecords
                records

            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="pagination-box">

                    <a href="@Url.Action(
                        "ProjectList",
                        new
                        {
                            pageNumber = Model.PageNumber - 1,
                            searchKeyword = Model.SearchKeyword,
                            status = Model.Status
                        })"
                       class="page-btn btn btn-sm btn-outline-secondary @(Model.PageNumber <= 1 ? "disabled" : "")">

                        <i class="bi bi-chevron-left"></i>

                    </a>

                    @for (int i = 1;
                   i <= Model.TotalPages;
                   i++)
                    {
                        <a href="@Url.Action(
                            "ProjectList",
                            new
                            {
                                pageNumber = i,
                                searchKeyword = Model.SearchKeyword,
                                status = Model.Status
                            })"
                           class="page-btn btn btn-sm @(i == Model.PageNumber ? "active" : "btn-outline-secondary")">

                            @i

                        </a>
                    }

                    <a href="@Url.Action(
                        "ProjectList",
                        new
                        {
                            pageNumber = Model.PageNumber + 1,
                            searchKeyword = Model.SearchKeyword,
                            status = Model.Status
                        })"
                       class="page-btn btn btn-sm btn-outline-secondary @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">

                        <i class="bi bi-chevron-right"></i>

                    </a>

                </div>
            }

        </div>

    </div>

</div>

<partial name="AlertModal" />

@section Scripts {

    <script src="~/js/Alert_Modal.js"
            asp-append-version="true">
    </script>

    <script src="~/js/project-list.js"
            asp-append-version="true">
    </script>
}