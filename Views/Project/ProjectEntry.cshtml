@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create New Project</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/project-entry.css" />
</head>
<body class="project-entry-bg">

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-9 col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">

                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3 mb-3 folder-icon-box" style="width: 48px; height: 48px;">
                            <i class="bi bi-folder-fill fs-2"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1">Create New Project</h3>
                        <p class="text-muted small">Set up the basic information for your new project to get started.</p>
                    </div>

                    <form id="projectForm">

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">Project Code <span class="text-danger">*</span></label>
                                <input type="text" id="ProjectCode" name="ProjectCode" class="form-control rounded-3 py-2" placeholder="Enter project Code" required />
                                <div class="form-text text-muted form-help-text">Choose a clear and unique code for your project.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">Project Name <span class="text-danger">*</span></label>
                                <input type="text" id="ProjectName" name="ProjectName" class="form-control rounded-3 py-2" placeholder="Enter project name" required />
                                <div class="form-text text-muted form-help-text">Choose a clear and unique name for your project.</div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">Project Manager <span class="text-danger">*</span></label>
                                <select id="ProjectManagerId" name="ProjectManagerId" class="form-select rounded-3 py-2 text-muted" required>
                                    <option value="" selected disabled>Select project manager</option>
                                    @if (ViewBag.Managers != null)
                                    {
                                        foreach (var manager in ViewBag.Managers)
                                        {
                                            <option value="@manager.StaffCode" class="text-dark">@manager.Name</option>
                                        }
                                    }
                                </select>
                                <div class="form-text text-muted form-help-text">Choose the person who will be responsible for this project.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">Project Git Link</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted rounded-start-3"><i class="bi bi-link-45deg fs-5"></i></span>
                                    <input type="url" id="GitRepositoryUrl" name="GitRepositoryUrl" class="form-control border-start-0 rounded-end-3 py-2" placeholder="Enter repository URL (e.g., https://github.com/company/...)" />
                                </div>
                                <div class="form-text text-muted form-help-text">Provide the repository link for this project.</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Description</label>
                            <textarea id="Description" name="Description" class="form-control rounded-3" rows="3" placeholder="Enter project description"></textarea>
                            <div class="form-text text-muted form-help-text">Provide a brief overview of the project, its goals, and objectives.</div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">Start Date <span class="text-danger">*</span></label>
                                <input type="date" id="StartDate" name="StartDate" class="form-control rounded-3 py-2 text-muted" required />
                                <div class="form-text text-muted form-help-text">When the project will begin.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">Target End Date <span class="text-danger">*</span></label>
                                <input type="date" id="EndDate" name="EndDate" class="form-control rounded-3 py-2 text-muted" required />
                                <div class="form-text text-muted form-help-text">Expected completion date.</div>
                            </div>
                        </div>

                        <div class="row align-items-center mb-4">
                            <div class="col-auto">
                                <label class="form-label fw-semibold text-dark mb-0">Status</label>
                            </div>
                            <div class="col-auto ms-4">
                                <div class="form-check form-check-inline me-3">
                                    <input class="form-check-input" type="radio" name="Status" id="statusActive" value="Active" checked>
                                    <label class="form-check-label fw-medium" for="statusActive">Active</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="Status" id="statusInactive" value="Inactive">
                                    <label class="form-check-label fw-medium" for="statusInactive">Inactive</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2">
                            <button type="button" id="btnClear" class="btn btn-light border rounded-3 px-4 fw-medium text-secondary">Clear</button>
                            <button type="submit" id="btnCreate" class="btn btn-primary rounded-3 px-4 fw-medium">+ Create Project</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {

            $('#ProjectCode').focus();

            $('#btnClear').click(function () {
                $('#projectForm')[0].reset();
                $('#statusActive').prop('checked', true);
                $('#ProjectCode').focus();
            });

            $('#projectForm').submit(function (e) {
                e.preventDefault();

                let code = $('#ProjectCode').val().trim();
                let name = $('#ProjectName').val().trim();
                let manager = $('#ProjectManagerId').val();
                let startVal = $('#StartDate').val();
                let endVal = $('#EndDate').val();

                if (!code || !name || !manager || !startVal || !endVal) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Required Field',
                        text: 'Please fill in all required fields.'
                    });
                    return;
                }

                let startDate = new Date(startVal);
                let endDate = new Date(endVal);

                if (startDate >= endDate) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Invalid Date Range',
                        text: 'Start Date must be earlier than Target End Date.'
                    });
                    return;
                }

                let formData = {
                    ProjectCode: code,
                    ProjectName: name,
                    ProjectManagerId: manager,
                    GitRepositoryUrl: $('#GitRepositoryUrl').val().trim(),
                    Description: $('#Description').val().trim(),
                    StartDate: startVal,
                    TargetEndDate: endVal, 
                    EndDate: endVal,
                    Status: $('input[name="Status"]:checked').val()
                };

                $('#btnCreate').prop('disabled', true).text('Saving...');

                $.ajax({
                    url: '/Project/CreateProject',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function (response) {
                        $('#btnCreate').prop('disabled', false).html('+ Create Project');

                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: response.message,
                                confirmButtonText: 'OK'
                            }).then(() => {
                                $('#btnClear').click();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error Details',
                                text: response.message
                            });
                        }
                    },
                    error: function (xhr) {
                        $('#btnCreate').prop('disabled', false).html('+ Create Project');

                        let errorMsg = 'An error occurred while processing your request.';

                        
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            errorMsg = xhr.responseText;
                        }

                        Swal.fire({
                            icon: 'error',
                            title: 'Server Error Details',
                            text: errorMsg
                        });
                    }
                });
            });
        });
    </script>
</body>
</html>