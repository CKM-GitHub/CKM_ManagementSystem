@model CKM_ManagementSystem.Models.ViewModels.Projects.ProjectEntryViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = Model.IsEdit ? "Edit Project" : "Create New Project";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/project-entry.css"
          asp-append-version="true" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">

                <div class="text-center mb-4">

                    <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3 mb-3 icon-header-box">
                        <i class="bi bi-folder-fill fs-3"></i>
                    </div>

                    <h1 class="main-header mb-1">
                        @(Model.IsEdit
                            ? "Edit Project"
                            : "Create New Project")
                    </h1>

                    <p class="text-muted small-text">
                        @(Model.IsEdit
                            ? "Update existing project details."
                            : "Set up the basic information for your new project to get started.")
                    </p>

                </div>

                <form id="projectForm">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="IsEdit"
                           id="IsEdit" />

                    @if (Model.IsEdit)
                    {
                        <input type="hidden"
                               asp-for="ProjectCode"
                               id="HiddenProjectCode" />
                    }

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3 small-text">
                    </div>

                    <div class="row g-3 mb-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                Project Code
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="ProjectCode"
                                   id="ProjectCode"
                                   class="form-control rounded-3 py-2"
                                   placeholder="Enter project Code"
                                   maxlength="50"
                                   disabled="@(Model.IsEdit ? "disabled" : null)" />

                            <span asp-validation-for="ProjectCode"
                                  id="valProjectCode"
                                  class="text-danger small-text">
                            </span>

                            <div class="form-help-text text-muted">
                                Choose a clear and unique code for your project.
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Project Name
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="ProjectName"
                                   id="ProjectName"
                                   class="form-control rounded-3 py-2"
                                   placeholder="Enter project name"
                                   maxlength="200" />

                            <span asp-validation-for="ProjectName"
                                  id="valProjectName"
                                  class="text-danger small-text">
                            </span>

                            <div class="form-help-text text-muted">
                                Choose a clear and unique name for your project.
                            </div>

                        </div>

                    </div>

                    <div class="row g-3 mb-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                Project Manager
                                <span class="text-danger">*</span>
                            </label>

                            <select asp-for="ProjectManagerId"
                                    id="ProjectManagerId"
                                    asp-items="@(ViewBag.Managers as List<SelectListItem>)"
                                    class="form-select rounded-3 py-2 select-truncate">

                                <option value=""
                                        selected
                                        disabled>
                                    Select project manager
                                </option>

                            </select>

                            <span asp-validation-for="ProjectManagerId"
                                  class="text-danger small-text">
                            </span>

                            <div class="form-help-text text-muted">
                                Choose the person who will be responsible for this project.
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Project Git Link
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-white border-end-0 text-muted rounded-start-3">
                                    <i class="bi bi-link-45deg fs-5"></i>
                                </span>

                                <input asp-for="GitRepositoryUrl"
                                       id="GitRepositoryUrl"
                                       class="form-control border-start-0 rounded-end-3 py-2"
                                       placeholder="https://github.com/company/repo" />

                            </div>

                            <span asp-validation-for="GitRepositoryUrl"
                                  class="text-danger small-text">
                            </span>

                            <div class="form-help-text text-muted">
                                Provide the repository link for this project.
                            </div>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  id="Description"
                                  class="form-control rounded-3"
                                  rows="3"
                                  placeholder="Enter project description"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger small-text">
                        </span>

                        <div class="form-help-text text-muted">
                            Provide a brief overview of the project, its goals, and objectives.
                        </div>

                    </div>

                    <div class="row g-3 mb-4">

                        <div class="col-md-6">

                            <label class="form-label">
                                Start Date
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="StartDate"
                                   type="date"
                                   id="StartDate"
                                   class="form-control rounded-3 py-2"
                                   value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />

                            <span asp-validation-for="StartDate"
                                  id="valStartDate"
                                  class="text-danger small-text">
                            </span>

                            <div class="form-help-text text-muted">
                                When the project will begin.
                            </div>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label">
                                Target End Date
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="EndDate"
                                   type="date"
                                   id="EndDate"
                                   class="form-control rounded-3 py-2"
                                   value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />

                            <span asp-validation-for="EndDate"
                                  id="valEndDate"
                                  class="text-danger small-text">
                            </span>

                            <div class="form-help-text text-muted">
                                Expected completion date.
                            </div>

                        </div>

                    </div>

                    <div class="row align-items-center mb-4">

                        <div class="col-auto">
                            <label class="form-label mb-0 me-3">
                                Status
                            </label>
                        </div>

                        <div class="col-auto">

                            <div class="form-check form-check-inline me-3">

                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="Status"
                                       value="Active"
                                       id="statusActive"
                                       checked="@(Model.Status == "Active" || string.IsNullOrEmpty(Model.Status))" />

                                <label class="form-check-label fw-medium"
                                       for="statusActive">
                                    Active
                                </label>

                            </div>

                            <div class="form-check form-check-inline me-3">

                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="Status"
                                       value="Completed"
                                       id="statusCompleted"
                                       checked="@(Model.Status == "Completed")" />

                                <label class="form-check-label fw-medium"
                                       for="statusCompleted">
                                    Completed
                                </label>

                            </div>

                            <div class="form-check form-check-inline me-3">

                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="Status"
                                       value="On Hold"
                                       id="statusOnHold"
                                       checked="@(Model.Status == "On Hold")" />

                                <label class="form-check-label fw-medium"
                                       for="statusOnHold">
                                    On Hold
                                </label>

                            </div>

                            <div class="form-check form-check-inline">

                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="Status"
                                       value="Inactive"
                                       id="statusInactive"
                                       checked="@(Model.Status == "Inactive")" />

                                <label class="form-check-label fw-medium"
                                       for="statusInactive">
                                    Inactive
                                </label>

                            </div>

                        </div>

                    </div>

                    <div class="row align-items-center mb-4">

                        <div class="col-auto">
                            <label class="form-label mb-0 me-3">
                                Project Type
                            </label>
                        </div>

                        <div class="col-auto">

                            <div class="form-check form-check-inline me-3">

                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="ProjectType"
                                       value="SYS"
                                       id="projectTypeSYS"
                                       checked="@(Model.ProjectType == "SYS" || string.IsNullOrEmpty(Model.ProjectType))" />

                                <label class="form-check-label fw-medium"
                                       for="projectTypeSYS">
                                    SYS - System
                                </label>

                            </div>

                            <div class="form-check form-check-inline me-3">

                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="ProjectType"
                                       value="BPO"
                                       id="projectTypeBPO"
                                       checked="@(Model.ProjectType == "BPO")" />

                                <label class="form-check-label fw-medium"
                                       for="projectTypeBPO">
                                    BPO - Business Process Outsourcing
                                </label>

                            </div>

                            <div class="form-check form-check-inline">

                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="ProjectType"
                                       value="HR"
                                       id="projectTypeHR"
                                       checked="@(Model.ProjectType == "HR")" />

                                <label class="form-check-label fw-medium"
                                       for="projectTypeHR">
                                    HR - Human Resources
                                </label>

                            </div>

                        </div>

                    </div>

                    <hr class="text-muted opacity-25 my-4" />

                    <div class="mb-4">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <h2 class="section-title mb-0">
                                Project Members
                            </h2>

                            <button type="button"
                                    class="btn btn-add-member-custom text-primary border-0 rounded-3 btn-sm fw-medium px-3"
                                    data-bs-toggle="modal"
                                    data-bs-target="#memberModal">
                                + Add Member
                            </button>

                        </div>

                        <div class="table-responsive border rounded-3">

                            <table class="table table-hover align-middle mb-0"
                                   id="tblSelectedMembers">

                                <thead class="bg-light text-muted">

                                    <tr>
                                        <th class="text-center col-width-50">
                                            NO.
                                        </th>

                                        <th class="col-width-140">
                                            STAFF CODE
                                        </th>

                                        <th>
                                            STAFF NAME
                                        </th>

                                        <th class="text-end col-width-60">
                                            Action
                                        </th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @if (Model.ProjectMembers != null &&
                                    Model.ProjectMembers.Any())
                                    {
                                        int no = 1;

                                        foreach (var member in Model.ProjectMembers)
                                        {
                                            <tr data-staffcode="@member.Staff_Code"
                                                data-img="@member.Image_URL">

                                                <td class="text-center text-muted row-no">
                                                    @no
                                                </td>

                                                <td>

                                                    <div class="d-flex align-items-center">

                                                        <img src="@(string.IsNullOrEmpty(member.Image_URL) ? "/images/default-avatar.png" : member.Image_URL)"
                                                             onerror="this.onerror=null;this.src='/images/default-avatar.png';"
                                                             class="rounded-circle me-2 flex-shrink-0 member-avatar" />

                                                        <span class="fw-semibold text-dark">
                                                            @member.Staff_Code
                                                        </span>

                                                    </div>

                                                </td>

                                                <td class="text-secondary">

                                                    <span class="text-truncate-custom cursor-pointer"
                                                          data-bs-toggle="tooltip"
                                                          title="@member.Name">
                                                        @member.Name
                                                    </span>

                                                </td>

                                                <td class="text-end">

                                                    <button type="button"
                                                            class="member-action-btn member-delete-icon btn-remove-member"
                                                            title="Remove Member">

                                                        <i class="bi bi-trash"></i>

                                                    </button>

                                                </td>

                                            </tr>

                                            no++;
                                        }
                                    }
                                    else
                                    {
                                        <tr id="emptyMemberRow">

                                            <td colspan="4"
                                                class="text-center text-muted py-3">

                                                No project members added.

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3">

                        <button type="button"
                                id="btnClear"
                                class="btn-clear-project">

                            @(Model.IsEdit
                                ? "Cancel"
                                : "Clear")

                        </button>

                        <button type="submit"
                                id="btnRegister"
                                class="btn btn-primary rounded-3 px-4 py-2 fw-medium">

                            @(Model.IsEdit
                                ? "Update Project"
                                : "+ Create Project")

                        </button>

                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

<div class="modal fade"
     id="memberModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content rounded-4 border-0 shadow-lg">

            <div class="modal-header border-0 pb-0 px-4 pt-4">

                <h2 class="modal-title">
                    Manage Project Members
                </h2>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body p-4">

                <div class="row g-2 mb-3">

                    <div class="col-md-5">

                        <input type="text"
                               id="modalSearchText"
                               class="form-control rounded-3 py-2"
                               placeholder="Staff Name / Code" />

                    </div>

                    <div class="col-md-4">

                        <select id="modalDeptSelect"
                                class="form-select rounded-3 py-2 select-truncate"
                                asp-items="@(ViewBag.Departments as List<SelectListItem>)">

                            <option value=""
                                    selected>
                                All Departments
                            </option>

                        </select>

                    </div>

                    <div class="col-md-3">

                        <button type="button"
                                id="btnModalSearch"
                                class="btn btn-primary rounded-3 w-100 py-2 fw-medium">

                            <i class="bi bi-search me-1"></i>
                            Search

                        </button>

                    </div>

                </div>

                <div class="table-responsive border rounded-3 modal-table-container">

                    <table class="table table-hover align-middle mb-0"
                           id="tblModalMembers">

                        <thead class="bg-light text-muted">

                            <tr>
                                <th class="text-center col-width-45"></th>
                                <th class="col-width-130">STAFF CODE</th>
                                <th>STAFF NAME</th>
                                <th>DEPARTMENT NAME</th>
                            </tr>

                        </thead>

                        <tbody class="text-secondary">

                            <tr>
                                <td colspan="4"
                                    class="text-center text-muted py-3">

                                    Click search to find staff members.

                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

            <div class="modal-footer border-0 px-4 pb-4 pt-0">

                <button type="button"
                        class="btn btn-outline-secondary rounded-3 px-4 py-2"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        id="btnAddSelectedMembers"
                        class="btn btn-primary rounded-3 px-4 py-2 fw-medium">
                    Add Members
                </button>

            </div>

        </div>
    </div>
</div>

@await Html.PartialAsync("~/Views/Shared/AlertModal.cshtml")

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/Alert_Modal.js"
            asp-append-version="true">
    </script>

    <script src="~/js/project-entry.js"
            asp-append-version="true">
    </script>
}