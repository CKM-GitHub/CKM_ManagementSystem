@{
    ViewData["Title"] = "Create New Project";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4">

               
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-dark mb-1">Create New Project</h3>
                    <p class="text-muted small">Set up the basic information for your new project to get started.</p>
                </div>

                <form id="projectForm">
                    
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-dark">Project Code <span class="text-danger">*</span></label>
                            <input type="text" id="ProjectCode" name="ProjectCode" class="form-control" placeholder="Enter project Code" required />
                            <div class="form-text text-muted" style="font-size: 12px;">Choose a clear and unique code for your project.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-dark">Project Name <span class="text-danger">*</span></label>
                            <input type="text" id="ProjectName" name="ProjectName" class="form-control" placeholder="Enter project name" required />
                            <div class="form-text text-muted" style="font-size: 12px;">Choose a clear and unique name for your project.</div>
                        </div>
                    </div>

                   
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-dark">Project Manager <span class="text-danger">*</span></label>
                            <select id="ProjectManager" name="ProjectManager" class="form-select" required>
                                <option value="">Select project manager</option>
                               
                                <option value="EMP001">U Aung Kyaw</option>
                                <option value="EMP002">Daw Aye Mya</option>
                            </select>
                            <div class="form-text text-muted" style="font-size: 12px;">Choose the person who will be responsible for this project.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-dark">Project Git Link</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-link-45deg"></i></span>
                                <input type="url" id="GitLink" name="GitLink" class="form-control" placeholder="Enter repository URL" />
                            </div>
                            <div class="form-text text-muted" style="font-size: 12px;">Provide the repository link for this project.</div>
                        </div>
                    </div>

                   
                    <div class="mb-3">
                        <label class="form-label fw-medium text-dark">Description</label>
                        <textarea id="Description" name="Description" class="form-control" rows="3" placeholder="Enter project description"></textarea>
                        <div class="form-text text-muted" style="font-size: 12px;">Provide a brief overview of the project, its goals, and objectives.</div>
                    </div>

                    
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-dark">Start Date <span class="text-danger">*</span></label>
                            <input type="date" id="StartDate" name="StartDate" class="form-control" required />
                            <div class="form-text text-muted" style="font-size: 12px;">When the project will begin.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium text-dark">Target End Date <span class="text-danger">*</span></label>
                            <input type="date" id="EndDate" name="EndDate" class="form-control" required />
                            <div class="form-text text-muted" style="font-size: 12px;">Expected completion date.</div>
                        </div>
                    </div>

                   
                    <div class="mb-4">
                        <label class="form-label fw-medium text-dark d-block">Status</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="Status" id="statusActive" value="Active" checked>
                            <label class="form-check-label" for="statusActive">Active</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="Status" id="statusInactive" value="Inactive">
                            <label class="form-check-label" for="statusInactive">Inactive</label>
                        </div>
                    </div>

                    
                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <button type="button" id="btnClear" class="btn btn-outline-secondary px-4">Clear</button>
                        <button type="submit" id="btnCreate" class="btn btn-primary px-4">+ Create Project</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
           
            $('#ProjectCode').focus();

            
            $('#btnClear').click(function () {
                $('#projectForm')[0].reset(); 
                $('#statusActive').prop('checked', true); 
                $('#ProjectCode').focus(); 
            });

            
            $('#projectForm').submit(function (e) {
                e.preventDefault(); 

               
                let startDate = new Date($('#StartDate').val());
                let endDate = new Date($('#EndDate').val());

                if (startDate > endDate) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Invalid Date',
                        text: 'Start Date cannot be greater than Target End Date.'
                    });
                    return; 
                }

               
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: 'Frontend validation passed. Ready for backend integration.',
                    confirmButtonText: 'OK'
                }).then(() => {
                    
                    $('#btnClear').click();
                });
            });
        });
    </script>
}