@using CKM_ManagementSystem.Models.ViewModels.User
@model UserCreateViewModel
@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/UserCreate.js" asp-append-version="true"></script>
    <script src="~/js/Alert_Modal.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/UserCreate.css" />
<link rel="stylesheet" href="~/css/ckm-theme.css" asp-append-version="true" />

<div class="container d-flex justify-content-center align-items-center pt-2">
    <div class="card border-0 rounded-4 shadow pt-3 pt-md-4 pb-4 pb-md-5 px-4 px-md-5 bg-white w- user-entry-card">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            var redirectUrl = Url.Action("UserList", "UserList");

            <input type="hidden" id="successMessage" value="@successMessage" />
            <input type="hidden" id="redirectUrl" value="@redirectUrl" />
        }

        <div class="d-flex align-items-center justify-content-center position-relative py-1 mb-3">
            <h1 class="text-center fw-bold mb-0 user-entry-title">
                @(
                    ViewBag.Source == "Profile"
                          ? "User Info"
                          : Model.Mode == "Entry"
                           ?"User Entry"
                           :"User Update"
                )
            </h1>
        </div>

        <form class="row g-3 g-md-4"
              method="post"
              asp-controller="@(Model.Mode == "Entry" ? "UserCreate" : "UserList")"
              asp-action="@(Model.Mode == "Entry" ? "UserCreate" : "UserUpdate")"
              enctype="multipart/form-data"
              id="UserForm">

            <div class="col-12 col-md-4 d-flex flex-column align-items-center border-end-md pe-md-4 mb-3 mb-md-0">
                <label class="form-label fw-semibold text-secondary mb-3">
                    Profile Photo
                </label>

                <div class="d-flex flex-column align-items-center w-100">
                    <div class="avatar-preview-circle rounded-circle border border-2 overflow-hidden d-flex align-items-center justify-content-center">
                        @if (Model.Mode == "Entry")
                        {
                            @if (!string.IsNullOrEmpty(Model.TempImageName))
                            {
                                <img id="avatar-preview"
                                     src="@Url.Content("~/images/temp/" + Model.TempImageName)"
                                     class="rounded-circle w-100 h-100 object-fit-cover"
                                     alt="Profile Preview" />
                                <i id="default-icon" class="bi bi-camera-fill d-none"></i>
                            }
                            else
                            {
                                <img id="avatar-preview"
                                     class="rounded-circle d-none w-100 h-100 object-fit-cover"
                                     alt="Profile Preview" />
                                <i id="default-icon" class="bi bi-camera-fill"></i>
                            }
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(Model.TempImageName))
                            {
                                <img id="avatar-preview"
                                     src="@Url.Content("~/images/temp/" + Model.TempImageName)"
                                     class="w-100 h-100 object-fit-cover"
                                     alt="Profile Preview">
                            }
                            else if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img id="avatar-preview"
                                     src="@Url.Content(Model.ImageUrl)"
                                     class="w-100 h-100 object-fit-cover"
                                     alt="Profile Preview">
                            }
                            else
                            {
                                <i id="default-icon"
                                   class="fa-solid fa-camera text-secondary"></i>
                                <img id="avatar-preview"
                                     class="w-100 h-100 object-fit-cover d-none"
                                     alt="Profile Preview">
                            }
                        }
                    </div>

                    <label for="image-upload"
                           class="btn border border-secondary-subtle d-flex align-items-center justify-content-center gap-2 px-3 py-2 upload-btn mt-3 text-primary fw-bold">
                        <i class="fa-regular fa-user"></i>
                        Upload Profile
                    </label>

                    @if (Model.Mode == "Entry")
                    {
                        <input type="hidden" asp-for="TempImageName" />
                    }
                    else
                    {
                        <input type="hidden" asp-for="ImageUrl" />
                        <input type="hidden" asp-for="TempImageName" />
                    }

                    <input type="file"
                           id="image-upload"
                           asp-for="ImageFile"
                           class="d-none"
                           accept=".jpg,.jpeg,.png,.gif,image/*" />
                </div>

                <span asp-validation-for="ImageFile" class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-8 ps-md-2">
                <div class="row g-3">
                    <div class="col-12">
                        <div class="row align-items-center">
                            <label asp-for="StaffCode" class="col-12 col-sm-4 col-form-label fw-medium text-secondary"></label>
                            <div class="col-12 col-sm-8">
                                @if (Model.Mode == "Entry")
                                {
                                    <input type="text" asp-for="StaffCode" class="form-control rounded-3 py-2" placeholder="e.g. CKM-0001" autofocus>
                                    <span asp-validation-for="StaffCode" class="text-danger small"></span>
                                }
                                else
                                {
                                    <input type="text" asp-for="StaffCode" class="form-control rounded-3 py-2" readonly>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="row align-items-center">
                            <label asp-for="Name" class="col-12 col-sm-4 form-label fw-medium text-secondary mb-1 mb-sm-0"></label>
                            <div class="col-12 col-sm-8">
                                <input type="text" asp-for="Name" class="form-control rounded-3 py-2" placeholder="Enter full name" maxlength="100" title="Maximum 100 characters">
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="row align-items-center">
                            <label asp-for="Email" class="col-12 col-sm-4 form-label fw-medium text-secondary mb-1 mb-sm-0"></label>
                            <div class="col-12 col-sm-8">
                                <input type="email" asp-for="Email" class="form-control rounded-3 py-2" placeholder="Enter email address" maxlength="200" title="Maximum 200 characters">
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    @if (Model.Mode == "Entry")
                    {
                        <div class="col-12">
                            <div class="row align-items-center">
                                <label asp-for="Password" class="col-12 col-sm-4 form-label fw-medium text-secondary mb-1 mb-sm-0"></label>
                                <div class="col-12 col-sm-8">
                                    <input type="password" asp-for="Password" class="form-control rounded-3 py-2" placeholder="Password">
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="row align-items-center">
                                <label asp-for="ConfirmPassword" class="col-12 col-sm-4 form-label fw-medium text-secondary mb-1 mb-sm-0"></label>
                                <div class="col-12 col-sm-8">
                                    <input type="password" asp-for="ConfirmPassword" class="form-control rounded-3 py-2" placeholder="Confirm password">
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="col-12">
                        <div class="row align-items-center">
                            <label class="col-12 col-sm-4 form-label fw-medium text-secondary mb-1 mb-sm-0">Gender</label>
                            <div class="col-12 col-sm-8 d-flex gap-4">
                                <div class="form-check">
                                    <input class="form-check-input gender-radio" type="radio" asp-for="Gender" value="Male" id="genderMale" checked>
                                    <label class="form-check-label text-secondary" for="genderMale">Male</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input gender-radio-unchecked" type="radio" asp-for="Gender" value="Female" id="genderFemale">
                                    <label class="form-check-label text-secondary" for="genderFemale">Female</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="row align-items-center">
                            <label asp-for="DepartmentCode" class="col-12 col-sm-4 form-label fw-medium text-secondary mb-1 mb-sm-0"></label>
                            <div class="col-12 col-sm-8">
                                <select asp-for="DepartmentCode" class="form-select rounded-3 py-2 text-secondary">
                                    <option value="">Select Department</option>
                                    @if (ViewBag.DepartmentList != null)
                                    {
                                        foreach (SelectListItem item in ViewBag.DepartmentList)
                                        {
                                            var departmentName = item.Text ?? string.Empty;
                                            var shortName = departmentName.Length > 25
                                            ? departmentName[..25] + "..."
                                            : departmentName;

                                            <option value="@item.Value"
                                                    data-role-name="@departmentName"
                                                    title="@(departmentName.Length > 25 ? departmentName : null)">
                                                @shortName
                                            </option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="DepartmentCode" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="row align-items-center">
                            <label asp-for="RoleCode" class="col-12 col-sm-4 form-label fw-medium text-secondary mb-1 mb-sm-0"></label>
                            <div class="col-12 col-sm-8">
                                <select asp-for="RoleCode"
                                        class="form-select rounded-3 py-2 text-secondary role-select"
                                        id="roleSelect"
                                        title="Select a role">
                                    <option value="">Select Role</option>

                                    @if (ViewBag.UserRoleList != null)
                                    {
                                        foreach (SelectListItem item in ViewBag.UserRoleList)
                                        {
                                            var roleName = item.Text ?? string.Empty;
                                            var shortName = roleName.Length > 18
                                            ? roleName[..30] + "..."
                                            : roleName;

                                            <option value="@item.Value"
                                                    data-role-name="@roleName"
                                                    title="@(roleName.Length > 18 ? roleName : null)">
                                                @shortName
                                            </option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="RoleCode" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="row align-items-center">
                            <label class="col-12 col-sm-4 form-label fw-medium text-secondary mb-1 mb-sm-0">Status</label>
                            <div class="col-12 col-sm-8 d-flex gap-4">
                                <div class="form-check">
                                    <input class="form-check-input status-radio" type="radio" asp-for="Status" value="true" id="statusActive" checked>
                                    <label class="form-check-label text-secondary" for="statusActive">Active</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input status-radio-unchecked" type="radio" asp-for="Status" value="false" id="statusInactive">
                                    <label class="form-check-label text-secondary" for="statusInactive">Inactive</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="row">
                            <div class="col-12 col-sm-8 offset-sm-4">
                                <div class="form-check d-flex align-items-start">
                                    <input class="form-check-input rounded-1 terms-checkbox mt-1" type="checkbox" asp-for="AcceptTerms">
                                    <label class="form-check-label text-secondary small ms-2" for="AcceptTerms">
                                        I agree to the Terms of Service and Privacy Policy
                                    </label>
                                </div>
                                <span class="text-danger small" id="acceptTermsError"></span>
                            </div>
                        </div>
                    </div>

                    <input asp-for="Mode" type="hidden" />
                </div>
            </div>

            <div class="col-12 d-flex flex-column flex-sm-row justify-content-end gap-2 gap-sm-3 mt-3 pt-2 border-top form-actions">
                @if (Model.Mode == "Entry")
                {
                    <button type="button" class="btn btn-light px-4 py-2 rounded-3 fw-medium border clear-btn" id="clearBtn">Clear</button>
                    <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 fw-medium create-btn" id="submitBtn">Create User</button>
                }
                else
                {
                    <a asp-action="UserList" asp-controller="UserList" class="btn btn-light px-4 py-2 rounded-3 fw-medium border clear-btn">Cancel</a>
                    <button type="submit" class="btn px-4 py-2 rounded-3 fw-medium create-btn">Update</button>
                }
            </div>
        </form>
    </div>
    <partial name="AlertModal" />
</div>