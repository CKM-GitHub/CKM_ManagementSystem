<div class="card shadow-sm border-0 mb-4 rounded-3">
    <div class="table-responsive">
        <table class="table table-custom align-middle mb-0 bg-white border-0 rounded-3">
            @if (Model.Data != null && Model.Data.Count > 0)
            {
                <thead class="bg-light text-secondary small">
                    <tr>
                        <th class="w-5 ps-4">No.</th>
                        <th class="w-12">Employee Code</th>
                        <th class="w-15">Name</th>
                        <th class="w-20">Email</th>
                        <th class="w-10">Department</th>
                        <th class="w-12">System Role</th>
                        <th class="w-10">Status</th>
                        <th class="w-10 text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = startItem;
                        foreach (var user in Model.Data)
                        {
                          @*  string roleBadgeClass = "badge-role-viewer";
                            string roleName = user.RoleName?.ToLower() ?? "";
                            if (roleName.Contains("manager")) { roleBadgeClass = "badge-role-manager"; }
                            else if (roleName.Contains("admin")) { roleBadgeClass = "badge-role-admin"; }
                            else if (roleName.Contains("teamleader")) { roleBadgeClass = "badge-role-leader"; }
                            else if (roleName.Contains("member")) { roleBadgeClass = "badge-role-member"; }  *@
                            <tr>
                                <td class="ps-4">@index</td>
                                <td>@user.StaffCode</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle border border-1 p-0 me-2">
                                            <img src="@(string.IsNullOrEmpty(user.ImageUrl) ? "https://api.dicebear.com/10.x/glyphs/svg" : user.ImageUrl)"
                                                 alt=""
                                                 class="rounded-circle"
                                                 width="34"
                                                 height="34">
                                        </div>
                                        <span class="text-truncate">@user.Name</span>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    <div class="text-truncate">@user.DepartmentName</div>
                                </td>
                                <td>
                                    <div class="text-truncate">@user.RoleName</div>
                                </td>
                                <td>
                                    @if (user.Status)
                                    {
                                        <span class="badge bg-light text-success border border-light rounded-pill badge-status active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-danger border border-light rounded-pill badge-status inactive">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-muted">
                                    <form asp-controller="UserList" asp-action="UserUpdate" method="get" class="d-inline me-2">
                                        <input type="hidden" name="staffCode" value="@user.StaffCode" />
                                        <button type="submit" class="p-0 border-0 bg-transparent edit-icon" title="Update">
                                            <i class="far fa-pen-to-square"></i>
                                        </button>
                                    </form>
                                    <form asp-controller="UserList"
                                          asp-action="DeleteUser"
                                          method="post"
                                          class="d-inline me-2 delete-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="staffCode" value="@user.StaffCode" />
                                        <button type="button" class="p-0 border-0 bg-transparent delete-icon" title="Delete">
                                            <i class="far fa-trash-can"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                </tbody>
            }
            else
            {
                <tbody style="height : 550px;" class="rounded">
                    <tr>
                        <td colspan="8" class="empty-state">
                            <i class="fas fa-user-slash"></i>
                            <span class="fs-5">Not found</span>
                        </td>
                    </tr>
                </tbody>
            }
        </table>
    </div>
    @if (totalPages > 1 || totalItems > 0)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top bg-white">
            <div class="small text-secondary mb-2 mb-md-0">
                Showing @startItem-@endItem of @totalItems users
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("UserList", "UserList", new { searchText = currentSearch, status = currentStatus, departmentCode = currentDept, roleCode = currentRole, pageNumber = currentPage - 1 })">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("UserList", "UserList", new { searchText = currentSearch, status = currentStatus, departmentCode = currentDept, roleCode = currentRole, pageNumber = i })">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("UserList", "UserList", new { searchText = currentSearch, status = currentStatus, departmentCode = currentDept, roleCode = currentRole, pageNumber = currentPage + 1 })">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/UserList.js"></script>
}
