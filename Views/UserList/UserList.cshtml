@model CKM_ManagementSystem.Models.ViewModels.PagedResponse<CKM_ManagementSystem.Models.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "User Management";

    string? currentSearch = ViewBag.SearchText as string;
    bool? currentStatus = ViewBag.Status as bool?;
    string? currentDept = ViewBag.DepartmentCode as string;
    string? currentRole = ViewBag.RoleCode as string;
    int currentPage = ViewBag.PageNumber ?? 1;
    int pageSize = 10; 
    int totalItems = Model.TotalCount;
    int startItem = totalItems > 0 ? (currentPage - 1) * pageSize + 1 : 0;
    int endItem = totalItems > 0 ? Math.Min(currentPage * pageSize, totalItems) : 0;
    int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
    if (totalPages < 1) totalPages = 1;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/UserList.css" />

<h1 class="text-center text-dark fw-bold mb-4 header-text">User Management</h1>
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 mb-4">
    <div class="col">
        <div class="card h-100 shadow-sm p-3 d-flex flex-row align-items-center gap-3 border-0">
            <div class="stat-icon-box bg-light text-primary"><i class="fas fa-users"></i></div>
            <div>
                <div class="text-secondary small">Total Users</div>
                <div class="fs-4 fw-bold text-dark">@Model.OverallTotalCount</div>
                <div class="small text-muted">All registered users <i class="far fa-question-circle"></i></div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 shadow-sm p-3 d-flex flex-row align-items-center gap-3 border-0">
            <div class="stat-icon-box bg-success bg-opacity-10 text-success"><i class="fas fa-user-check"></i></div>
            <div>
                <div class="text-secondary small">Active Users</div>
                <div class="fs-4 fw-bold text-dark">@Model.OverallActiveCount</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 shadow-sm p-3 d-flex flex-row align-items-center gap-3 border-0">
            <div class="stat-icon-box bg-warning bg-opacity-10 text-warning"><i class="fas fa-user-slash"></i></div>
            <div>
                <div class="text-secondary small">Inactive Users</div>
                <div class="fs-4 fw-bold text-dark">@Model.OverallInactiveCount</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 shadow-sm p-3 d-flex flex-row align-items-center gap-3 border-0">
            <div class="stat-icon-box bg-purple bg-opacity-10 text-purple"><i class="fas fa-building" style="color: #a855f7;"></i></div>
            <div>
                <div class="text-secondary small">Departments</div>
                <div class="fs-4 fw-bold text-dark">@Model.DepartmentCount</div>
            </div>
        </div>
    </div>
</div>

<form method="get" asp-controller="UserList" asp-action="UserList" class="card shadow-sm p-3 mb-4 border-0">
    <div class="d-flex flex-wrap align-items-center gap-2 justify-content-between">
        <div class="d-flex flex-wrap align-items-center gap-2 flex-grow-1 search-form-container">
            <div class="search-wrapper">
                <i class="fas fa-search search-icon"></i>
                <input type="text" name="searchText" value="@currentSearch" class="form-control text-secondary small search-input-with-icon" placeholder="Search users by name, email, or code">
            </div>
            <div class="search-wrapper">
                <select name="departmentCode" class="form-select  text-secondary small">
                    <option value="">All Departments</option>
                    @foreach (var dept in Model.Departments)
                    {
                        var shortName = dept.DepartmentName.Length > 25 ?
                        dept.DepartmentName.Substring(0, 22) + "..."
                        : dept.DepartmentName;
                        <option value="@dept.DepartmentCode" selected="@(ViewBag.DepartmentCode == dept.DepartmentCode ? "selected" : null)">
                            @shortName
                        </option>
                    }
                </select>
            </div>           
            <div class="search-wrapper">
                <select name="roleCode" class="form-select text-secondary small">
                    <option value="">All Roles</option>
                    @foreach (var role in Model.Roles)
                    {
                        var shortName = role.RoleName.Length > 25 ?
                        role.RoleName.Substring(0, 22) + "..."
                        : role.RoleName;
                        <option value="@role.RoleCode" selected="@(ViewBag.RoleCode == role.RoleCode ? "selected" : null)">
                            @shortName
                        </option>
                    }
                </select>
            </div>          
            <div class="search-wrapper">
                <select name="status" class="form-select text-secondary small">
                    <option value="">All Status</option>
                    <option value="true" selected="@(currentStatus == true)">Active</option>
                    <option value="false" selected="@(currentStatus == false)">Inactive</option>
                </select>
            </div>         
            <div class="search-btn">
                <button type="submit" class="btn btn-primary px-3"><i class="fas fa-search me-1"></i> Search User</button>
            </div>            
            @* <a asp-action="UserList" class="btn btn-outline-secondary btn-sm px-3">Clear</a> *@
        </div>
        <div>
            <a class="btn btn-primary px-3" asp-controller="UserCreate" asp-action="UserCreate" asp-route-source="list"><i class="fas fa-plus me-1"></i> Add New User</a>
        </div>
        
    </div>
</form>
