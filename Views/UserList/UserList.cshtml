<partial name="AlertModal" />

    <div class="card custom-card shadow-sm border-0 mb-3 rounded-3 flex-grow-1 d-flex flex-column overflow-hidden">

        <div class="app-table-wrapper">
            <table class="app-table align-middle mb-0 bg-white">
                @if (Model.PagedData.Data != null && Model.PagedData.Data.Count > 0)
                {
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 5%;">No.</th>
                            <th style="width: 12%;">Employee Code</th>
                            <th style="width: 18%;">Name</th>
                            <th style="width: 20%;">Email</th>
                            <th style="width: 18%;">Department</th>
                            <th style="width: 15%;">System Role</th>
                            <th style="width: 7%;">Status</th>
                            <th class="text-center" style="width: 5%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int index = startItem;
                            foreach (var user in Model.PagedData.Data)
                            {
                                <tr>
                                    <td class="text-center">@index</td>
                                    <td>@user.StaffCode</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle border me-2 flex-shrink-0" style="width:34px; height:34px; overflow:hidden;">
                                                <img src="@(string.IsNullOrEmpty(user.ImageUrl) ? "https://api.dicebear.com/10.x/thumbs/svg?seed=Felix" : user.ImageUrl)"
                                                     alt=""
                                                     class="w-100 h-100 object-fit-cover">
                                            </div>
                                            <span class="text-truncate custom-tooltip" data-tooltip-title="@user.Name">
                                                @user.Name
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-truncate custom-tooltip" data-tooltip-title="@user.Email">
                                            @user.Email
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-truncate custom-tooltip" data-tooltip-title="@user.DepartmentName">
                                            @user.DepartmentName
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-truncate custom-tooltip" data-tooltip-title="@user.RoleName">
                                            @user.RoleName
                                        </div>
                                    </td>
                                    <td>
                                        @if (user.Status)
                                        {
                                            <span class="badge bg-light text-success border border-light rounded-pill badge-status active">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-danger border border-light rounded-pill badge-status inactive">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="action-buttons d-flex justify-content-center align-items-center gap-1">
                                            <form asp-controller="UserList" asp-action="UserUpdate" method="get" class="m-0">
                                                <input type="hidden" name="staffCode" value="@user.StaffCode" />
                                                <button type="submit" class="action-icon-btn edit-icon" title="Update">
                                                    <i class="far fa-pen-to-square"></i>
                                                </button>
                                            </form>

                                            <form asp-controller="UserList" asp-action="DeleteUser" method="post" class="delete-form m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="staffCode" value="@user.StaffCode" />
                                                <button type="button" class="action-icon-btn delete-icon" id="confirmdel" title="Delete">
                                                    <i class="far fa-trash-can"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                }
                else
                {
                    <tbody>
                        <tr>
                            <td colspan="8" class="text-center align-middle p-4">
                                <img src="https://media.giphy.com/media/v1.Y2lkPWVjZjA1ZTQ3d2RmYnFtZ2ZodjdzaHUxOGNtamowcXpoOGE5bjFtajNqMHh1cHNzYyZlcD12MV9naWZzX3JlbGF0ZWQmY3Q9Zw/1ngspjOjDggxO/giphy.gif"
                                     alt="Empty state animation"
                                     class="img-fluid d-block mx-auto"
                                     style="max-height: 250px; object-fit: contain;">
                            </td>
                        </tr>
                    </tbody>
                }
            </table>
        </div>

        @if (totalPages > 1 || totalItems > 0)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center p-3 border-top bg-white rounded-bottom">
                <div class="small text-secondary mb-2 mb-md-0">
                    Showing @startItem-@endItem of @totalItems users
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination mb-0 gap-1">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("UserList", "UserList", new { searchText = currentSearch, status = currentStatus, departmentCode = currentDept, roleCode = currentRole, pageNumber = currentPage - 1 })">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(currentPage == i ? "active" : "")">
                                <a class="page-link paging-btn" href="@Url.Action("UserList", "UserList", new { searchText = currentSearch, status = currentStatus, departmentCode = currentDept, roleCode = currentRole, pageNumber = i })">@i</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("UserList", "UserList", new { searchText = currentSearch, status = currentStatus, departmentCode = currentDept, roleCode = currentRole, pageNumber = currentPage + 1 })">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>

@section Scripts {
    <script src="~/js/Alert_Modal.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/UserList.js" asp-append-version="true"></script>
}
