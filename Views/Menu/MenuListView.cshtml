@model CKM_ManagementSystem.Models.ViewModels.MenuListViewModel

@{
    ViewData["Title"] = "Menu Management";
}
<div class="menu-page-shell">
    <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content custom-modal-popup">
                <div class="modal-body text-center p-4">
                    <div class="text-success mb-2">
                        <i class="bi bi-check-circle-fill display-4 text-emerald"></i>
                    </div>
                    <h5 class="custom-modal-title">Success!</h5>
                    <p class="custom-modal-text">@TempData["SuccessMessage"]</p>
                    <button type="button" class="btn custom-modal-btn w-100 mt-3" data-bs-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>
    <div class="menu-page-container">
        <div class="page-header text-center">
            <h2 class="page-title">Menu Management</h2>
        </div>
        
    </div>
    <div class="filter-card mb-3">
            <form method="get" asp-action="MenuListView" class="toolbar-row">
                <div class="toolbar-left">
                    <div class="search-box-wrapper">
                        <i class="bi bi-search search-icon "></i>
                        <input type="text" id="searchTermInput" name="searchTerm" class="form-control toolbar-input search-input"
                                placeholder="Search by Menu Name" value="@Model.SearchTerm" />
                    </div>
                    <div class="select-box-wrapper">
                        <select name="selectedParentId" asp-for="SelectedParentId" class="form-select toolbar-input" asp-items="Model.ParentMenuList">
                            <option value=""> All Menus </option>
                        </select>
                        <i class="bi bi-chevron-down select-icon"></i>
                    </div>
                    <div class="select-box-wrapper">
                        <select name="statusFilters" asp-for="StatusFilters" class="toolbar-input">
                            <option value="">All Status</option>
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                        <i class="bi bi-chevron-down select-icon"></i>
                    </div>
                    <button type="submit" class="btn btn-primary toolbar-btn ">
                        <i class="bi bi-search me-2"></i>Search Menu
                    </button>
                </div>
                <div class="toolbar-right">
                    <a asp-action ="MenuEntry" class="btn btn-primary add-btn">
                        <i class="bi bi-plus me-2"></i> Add Menu
                    </a>
                </div>
            </form>
    </div>
    <div class="table-card">
        <div class="table-responsive">
                <table class="table menu-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="col-no">No.</th>
                            <th class="col-name">Menu Name</th>
                            <th class="col-icon text-center">Icon</th>
                            <th class="col-route">Route</th>
                            <th class="col-parent">Parent Menu</th>
                            <th class="col-order text-center" >Display Order</th>
                            <th class="col-status text-center">Status</th>
                            <th class="col-actions text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(Model.Menus != null && Model.Menus.Any())
                        {
                        int index = ((Model.CurrentPage -1) * Model.PageSize) + 1;
                        @foreach(var item in Model.Menus)
                            {
                                <tr>
                                    <td class="text-center">@index</td>
                                    <td class="menu-name">@item.MenuName</td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.IconClass))
                                        {
                                            <i class="@item.IconClass table-icon"></i>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                   
                                    <td>
                                        <code class="route-text">
                                            @item.Route
                                        </code>
                                    </td>
                                    <td class="parent-text">
                                            @item.ParentMenuName
                                    </td>
                                    <td class="text-center ">@item.DisplayOrder.ToString("D3")</td>
                                    <td class="text-center">
                                        @if(item.Status){
                                            <span class="status-badge status-active">
                                                <span class="dot"></span>Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-hidden">
                                                <span class="dot"></span>Inactive
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="Menu" asp-action="MenuEntry" class="action-btn me-2" asp-route-menuId="@item.MenuID"><i class="bi bi-pencil-square"></i></a>
                                        <form asp-controller="Menu" asp-action="DeleteMenu" method="post" class="d-inline delete-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="menuId" value="@item.MenuID" />
                                            <button type="submit" class="action-btn border-0 p-0 bg-transparent delete-btn text-secondary" title="Delete Menu"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                            </tr>
                            index++;
                        }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2  d-block mb-2"></i>
                                    No Menus found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <form id="antiForgeryForm">
                    @Html.AntiForgeryToken()
                </form>
        </div>
        <div class="table-footer">
                <div class="footer-text">
                    @{
                        int startItem = Model.TotalItems == 0 ? 0 :((Model.CurrentPage -1) * Model.PageSize) + 1;
                        int endItem = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems);
                    }

                    Showing @startItem-@endItem of @Model.TotalItems records
                </div>
                @if(Model.TotalPages > 1)
                {
                    <div class="pagination-box">
                        <a href="@Url.Action("MenuListView", new{page = Model.CurrentPage - 1 , searchTerm=Model.SearchTerm, selectedParentId = Model.SelectedParentId, statusFilters = Model.StatusFilters})"
                            class="page-btn btn btn-sm btn-outline-secondary @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    
                        @for(int i=1; i<= Model.TotalPages ; i++)
                        {
                            <a href="@Url.Action("MenuListView", new{page = i, searchTerm = Model.SearchTerm, selectedParentId = Model.SelectedParentId, statusFilters = Model.StatusFilters })"
                                class="page-btn btn btn-sm @(i == Model.CurrentPage  ? "btn-primary active" : "btn-outline-secondary")">
                                @i
                            </a>
                        }
                        <a href="@Url.Action("MenuListView", new { page = Model.CurrentPage + 1, searchTerm = Model.SearchTerm, selectedParentId = Model.SelectedParentId , statusFilters = Model.StatusFilters})"
                           class="page-btn btn btn-sm btn-outline-secondary @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                }
        </div>
    </div>
</div>
@section Scripts {
    <script>
        var successMessage = '@(TempData["SuccessMessage"] ?? "")';
        var errorMessage = '@(TempData["ErrorMessage"] ?? "")';
    </script>
    <script src="~/lib/sweetalert2/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/menu-management.js" asp-append-version="true"></script>
}
@section Styles {
    <link rel="stylesheet" href="~/css/menu-management.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
}