@model CKM_ManagementSystem.Models.ViewModels.Tasks.TaskManagementFilterViewModel

@{
    ViewData["Title"] = "Task Management";
}

<div class="task-page-container">
    <div class="page-header text-center">
        <h2 class="page-title">Task Management</h2>
    </div>
</div>

<div class="container-fluid px-3 px-md-5">

    <!-- Search -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 search-card">
        <div class="card-body">

            <form asp-controller="Tasks"
                  asp-action="TaskListsPost"
                  method="post">

                <input type="hidden" asp-for="PageSize" />

                <div class="row g-3">

                    <div class="col-md-3">
                        <label asp-for="ProjectCode"
                               class="form-label">
                            Project Name
                        </label>

                        <select asp-for="ProjectCode"
                                asp-items="Model.ProjectList"
                                class="form-select form-select-md"
                                id="project">

                            <option value="">All Project</option>

                        </select>
                    </div>


                    <div class="col-md-3">
                        <label asp-for="PersonInCharge"
                               class="form-label">
                            Person In Charge
                        </label>

                        <select asp-for="PersonInCharge"
                                asp-items="Model.PersonInChargeList"
                                class="form-select form-select-md"
                                id="personInCharge">

                            <option value="">All Person In Charge</option>

                        </select>
                    </div>


                    <div class="col-md-6">
                        <label asp-for="Title"
                               class="form-label">
                            Task Title / Program Name
                        </label>

                        <input asp-for="Title"
                               type="text"
                               class="form-control form-control-md"
                               id="searchTitle"
                               placeholder="Enter Task Title" />
                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Issue Date
                        </label>

                        <div class="row">

                            <div class="date-width">

                                <input asp-for="IssueDateStart"
                                       type="date"
                                       class="form-control"
                                       id="searchStartDate" />

                            </div>

                            <div class="range">
                                <label class="form-label">~</label>
                            </div>

                            <div class="date-width">

                                <input asp-for="IssueDateEnd"
                                       type="date"
                                       class="form-control"
                                       id="searchEndDate" />

                            </div>

                        </div>
                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Due Date
                        </label>

                        <div class="row">

                            <div class="date-width">

                                <input asp-for="DueDateStart"
                                       type="date"
                                       class="form-control"
                                       id="searchDueStartDate" />

                            </div>

                            <div class="range">
                                <label class="form-label">~</label>
                            </div>

                            <div class="date-width">

                                <input asp-for="DueDateEnd"
                                       type="date"
                                       class="form-control"
                                       id="searchDueEndDate" />

                            </div>

                        </div>
                    </div>


                    <div class="col-md-3">

                        <label asp-for="Assignee"
                               class="form-label">
                            Assignee
                        </label>

                        <select asp-for="Assignee"
                                asp-items="Model.AssigneeList"
                                class="form-select form-select-md"
                                id="assignee">

                            <option value="">All Assignee</option>

                        </select>

                    </div>


                    <div class="col-md-3">

                        <label asp-for="PriorityCode"
                               class="form-label">
                            Priority
                        </label>

                        <select asp-for="PriorityCode"
                                asp-items="Model.PriorityList"
                                class="form-select form-select-md custom-select-limit"
                                id="priority">

                            <option value="">All Priority</option>

                        </select>

                    </div>


                    <div class="col-md-3">

                        <label asp-for="StatusCode"
                               class="form-label">
                            Status
                        </label>

                        <select asp-for="StatusCode"
                                asp-items="Model.StatusList"
                                class="form-select form-select-md custom-select-limit"
                                id="status">

                            <option value="">All Status</option>

                        </select>

                    </div>


                    <div class="col-12 text-end mt-4">

                        <button type="submit"
                                class="btn btn-primary-search toolbar-btn">

                            <i class="bi bi-search me-2"></i>
                            Search Status

                        </button>

                    </div>

                </div>

            </form>

        </div>
    </div>


    <!-- Table -->
    <div class="card main-card p-4">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0 text-nowrap sticky-table">

                <thead class="table-light">

                    <tr>

                        <th class="sticky-col col-1-sticky fw-semibold">
                            No.
                        </th>

                        <th class="sticky-col col-2-sticky fw-semibold">
                            Project Name
                        </th>

                        <th class="sticky-col col-3-sticky fw-semibold">
                            Person In Charge
                        </th>

                        <th class="sticky-col col-4-sticky fw-semibold">
                            Task Title / Program Name
                        </th>

                        <th class="fw-semibold col-desc">
                            Description
                        </th>

                        <th class="fw-semibold col-assignee">
                            Assignee
                        </th>

                        <th class="fw-semibold col-date">
                            Issue Date
                        </th>

                        <th class="fw-semibold col-date">
                            Due Date
                        </th>

                        <th class="fw-semibold col-priority">
                            Priority
                        </th>

                        <th class="fw-semibold col-status">
                            Status
                        </th>

                        <th class="fw-semibold col-date">
                            Start Date
                        </th>

                        <th class="fw-semibold col-date">
                            End Date
                        </th>

                        <th class="text-center fw-semibold col-action">
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.TaskListData != null &&
                    Model.TaskListData.Any())
                    {
                        int index =
                        ((Model.CurrentPage - 1)
                        * Model.PageSize) + 1;


                        foreach (var task in Model.TaskListData)
                        {
                            <tr>

                                <td class="sticky-col col-1-sticky">
                                    @(index++)
                                </td>


                                <td class="sticky-col col-2-sticky">

                                    <span class="text-limit"
                                          data-tooltip-truncate
                                          data-tooltip-text="@task.ProjectName">
                                        @task.ProjectName
                                    </span>

                                </td>


                                <td class="sticky-col col-3-sticky">

                                    <span class="text-limit"
                                          data-tooltip-truncate
                                          data-tooltip-text="@task.PersonInChargeName">
                                        @task.PersonInChargeName
                                    </span>

                                </td>


                                <td class="sticky-col col-4-sticky">

                                    <span class="text-limit"
                                          data-tooltip-truncate
                                          data-tooltip-text="@task.Title">
                                        @task.Title
                                    </span>

                                </td>


                                <td>

                                    <span class="text-limit"
                                          data-tooltip-truncate
                                          data-tooltip-text="@task.Description">

                                        @(string.IsNullOrWhiteSpace(task.Description)
                                            ? "-"
                                            : task.Description)

                                    </span>

                                </td>


                                <td>

                                    <span class="text-limit"
                                          data-tooltip-truncate
                                          data-tooltip-text="@task.AssigneeName">
                                        @task.AssigneeName
                                    </span>

                                </td>


                                <td>

                                    @(task.IssueDate != default
                                        ? task.IssueDate.ToString("yyyy-MM-dd")
                                        : "-")

                                </td>


                                <td>

                                    @(task.DueDate.HasValue
                                        ? task.DueDate.Value.ToString("yyyy-MM-dd")
                                        : "-")

                                </td>


                                <td>

                                    @if (string.Equals(
                                   task.PriorityName,
                                   "High",
                                   StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-priority-high px-2 py-1">
                                            @task.PriorityName
                                        </span>
                                    }
                                    else if (string.Equals(
                                    task.PriorityName,
                                    "Medium",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-priority-medium px-2 py-1">
                                            @task.PriorityName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-priority-low px-2 py-1">
                                            @task.PriorityName
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (string.Equals(
                                   task.StatusName,
                                   "Completed",
                                   StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-status-completed px-3 py-2">
                                            @task.StatusName
                                        </span>
                                    }
                                    else if (string.Equals(
                                    task.StatusName,
                                    "In Progress",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge badge-status-progress px-3 py-2">
                                            @task.StatusName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-status-hold px-3 py-2">
                                            @task.StatusName
                                        </span>
                                    }

                                </td>


                                <td>

                                    @(task.StartDate?
                                        .ToString("yyyy-MM-dd")
                                        ?? "-")

                                </td>


                                <td>

                                    @(task.EndDate?
                                        .ToString("yyyy-MM-dd")
                                        ?? "-")

                                </td>


                                <td class="text-center">

                                    <button type="button"
                                            class="action-btn edit-icon btn-edit"
                                            title="Edit Task"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editTaskModal"
                                            data-id="@task.ID"
                                            data-title="@task.Title"
                                            data-description="@task.Description"
                                            data-assignee="@task.AssigneeName"
                                            data-duedate="@(task.DueDate?.ToString("yyyy-MM-dd") ?? "")"
                                            data-priority="@task.PriorityName"
                                            data-status="@task.StatusName">

                                        <i class="bi bi-pencil-square"></i>

                                    </button>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="empty-task-row">

                            <td class="sticky-col col-1-sticky empty-sticky-cell"></td>

                            <td class="sticky-col col-2-sticky empty-sticky-cell"></td>

                            <td class="sticky-col col-3-sticky empty-sticky-cell"></td>

                            <td class="sticky-col col-4-sticky empty-sticky-cell"></td>

                            <td colspan="9"
                                class="empty-task-cell">

                                No task records found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- Pagination -->
        <div class="table-footer mt-3 d-flex justify-content-between align-items-center">

            <div class="footer-text">

                @{
                    int startItem =
                    Model.TotalItems == 0
                    ? 0
                    : ((Model.CurrentPage - 1)
                    * Model.PageSize) + 1;

                    int endItem =
                    Model.TotalItems == 0
                    ? 0
                    : Math.Min(
                    Model.CurrentPage * Model.PageSize,
                    Model.TotalItems);
                }

                Showing @startItem-@endItem
                of @Model.TotalItems records

            </div>


            @if (Model.TotalPages > 1)
            {
                <div class="pagination-box d-flex gap-1 align-items-center">


                    <a href="@Url.Action(
                        "TaskLists",
                        "Tasks",
                        new
                        {
                            CurrentPage = Model.CurrentPage - 1,
                            PageSize = Model.PageSize,
                            ProjectCode = Model.ProjectCode,
                            PersonInCharge = Model.PersonInCharge,
                            Title = Model.Title,
                            Assignee = Model.Assignee,
                            PriorityCode = Model.PriorityCode,
                            StatusCode = Model.StatusCode,
                            IssueDateStart = Model.IssueDateStart?.ToString("yyyy-MM-dd"),
                            IssueDateEnd = Model.IssueDateEnd?.ToString("yyyy-MM-dd"),
                            DueDateStart = Model.DueDateStart?.ToString("yyyy-MM-dd"),
                            DueDateEnd = Model.DueDateEnd?.ToString("yyyy-MM-dd")
                        })"
                       class="page-btn btn btn-sm btn-outline-secondary
                              @(Model.CurrentPage <= 1
                                  ? "disabled"
                                  : "")">

                        <i class="bi bi-chevron-left"></i>

                    </a>


                    @for (int i = 1;
                   i <= Model.TotalPages;
                   i++)
                    {
                        <a href="@Url.Action(
                            "TaskLists",
                            "Tasks",
                            new
                            {
                                CurrentPage = i,
                                PageSize = Model.PageSize,
                                ProjectCode = Model.ProjectCode,
                                PersonInCharge = Model.PersonInCharge,
                                Title = Model.Title,
                                Assignee = Model.Assignee,
                                PriorityCode = Model.PriorityCode,
                                StatusCode = Model.StatusCode,
                                IssueDateStart = Model.IssueDateStart?.ToString("yyyy-MM-dd"),
                                IssueDateEnd = Model.IssueDateEnd?.ToString("yyyy-MM-dd"),
                                DueDateStart = Model.DueDateStart?.ToString("yyyy-MM-dd"),
                                DueDateEnd = Model.DueDateEnd?.ToString("yyyy-MM-dd")
                            })"
                           class="page-btn btn btn-sm
                                  @(i == Model.CurrentPage
                                      ? "btn-primary-pagination active"
                                      : "btn-outline-secondary")">

                            @i

                        </a>
                    }


                    <a href="@Url.Action(
                        "TaskLists",
                        "Tasks",
                        new
                        {
                            CurrentPage = Model.CurrentPage + 1,
                            PageSize = Model.PageSize,
                            ProjectCode = Model.ProjectCode,
                            PersonInCharge = Model.PersonInCharge,
                            Title = Model.Title,
                            Assignee = Model.Assignee,
                            PriorityCode = Model.PriorityCode,
                            StatusCode = Model.StatusCode,
                            IssueDateStart = Model.IssueDateStart?.ToString("yyyy-MM-dd"),
                            IssueDateEnd = Model.IssueDateEnd?.ToString("yyyy-MM-dd"),
                            DueDateStart = Model.DueDateStart?.ToString("yyyy-MM-dd"),
                            DueDateEnd = Model.DueDateEnd?.ToString("yyyy-MM-dd")
                        })"
                       class="page-btn btn btn-sm btn-outline-secondary
                              @(Model.CurrentPage >= Model.TotalPages
                                  ? "disabled"
                                  : "")">

                        <i class="bi bi-chevron-right"></i>

                    </a>

                </div>
            }

        </div>

    </div>

</div>


<!-- Edit Task Modal -->
<div class="modal fade"
     id="editTaskModal"
     tabindex="-1"
     aria-labelledby="editTaskModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content custom-modal-card">

            <form id="editTaskForm"
                  asp-controller="Tasks"
                  asp-action="UpdateTask"
                  method="post">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       id="editTaskId"
                       name="ID" />


                <input type="hidden"
                       name="returnUrl"
                       value="@(Context.Request.Path + Context.Request.QueryString)" />


                <div class="modal-header border-0 pb-0 justify-content-center">

                    <h1 class="modal-title fw-bold"
                        id="editTaskModalLabel">

                        Edit Task

                    </h1>


                    <button type="button"
                            class="btn-close position-absolute end-0 me-3"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body pt-3">

                    <div class="row g-3">


                        <div class="col-12">

                            <label for="editTitle"
                                   class="form-label fw-semibold">
                                Title
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="editTitle"
                                   name="Title" readonly
                                   required />

                        </div>


                        <div class="col-12">

                            <label for="editDescription"
                                   class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea class="form-control"
                                      id="editDescription"
                                      name="Description" readonly
                                      rows="3"></textarea>

                        </div>


                        <div class="col-md-6">

                            <label for="editAssignee"
                                   class="form-label fw-semibold">
                                Assignee
                            </label>

                            <select class="form-select"
                                    id="editAssignee"
                                    name="Assignee"
                                    asp-items="Model.AssigneeList"
                                    required>

                                <option value="">
                                    Select Assignee
                                </option>

                            </select>

                        </div>


                        <div class="col-md-6">

                            <label for="editDueDate"
                                   class="form-label fw-semibold">
                                Due Date
                            </label>

                            <input type="date"
                                   class="form-control"
                                   id="editDueDate"
                                   name="DueDate" />

                        </div>


                        <div class="col-md-6">

                            <label for="editPriority"
                                   class="form-label fw-semibold">
                                Priority
                            </label>

                            <select class="form-select custom-select-limit"
                                    id="editPriority"
                                    name="PriorityCode"
                                    asp-items="Model.PriorityList"
                                    required>

                                <option value="">
                                    Select Priority
                                </option>

                            </select>

                        </div>


                        <div class="col-md-6">

                            <label for="editStatus"
                                   class="form-label fw-semibold">
                                Status
                            </label>

                            <select class="form-select custom-select-limit"
                                    id="editStatus"
                                    name="StatusCode"
                                    asp-items="Model.StatusList"
                                    required>

                                <option value="">
                                    Select Status
                                </option>

                            </select>

                        </div>


                    </div>

                </div>


                <div class="modal-footer border-0 p-4 pt-0">

                    <div class="row g-2 w-100 m-0">


                        <div class="col-6 ps-0 pe-1">

                            <button type="button"
                                    class="btn btn-cancel w-100 fw-bold"
                                    data-bs-dismiss="modal">

                                Cancel

                            </button>

                        </div>


                        <div class="col-6 ps-1 pe-0">

                            <button type="submit"
                                    id="btnRegister"
                                    class="btn btn-register custom-modal-btn w-100 fw-bold">

                                Update Task

                            </button>

                        </div>


                    </div>

                </div>


            </form>

        </div>

    </div>

</div>


<partial name="AlertModal" />


@section Styles {

    <link rel="stylesheet"
          href="~/css/Alert_Modal.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/ckm-theme.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/tasks.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/TaskLists.css"
          asp-append-version="true" />

}


@section Scripts {

    <script>
        var successMessage =
            '@(TempData["SuccessMessage"] ?? "")';

        var errorMessage =
            '@(TempData["ErrorMessage"] ?? "")';
    </script>


    <script src="~/js/Alert_Modal.js"
            asp-append-version="true">
    </script>


    <script src="~/js/task-lists.js"
            asp-append-version="true">
    </script>

}