@using CKM_ManagementSystem.Models.ViewModels.Roles
@model RoleListPagedViewModel

@{
    ViewData["Title"] = "Role Management";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/role-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Alert_Modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ckm-theme.css" asp-append-version="true" />
}

<div class="container-fluid px-4 px-md-5 pb-5">
    <h2 class="page-title">Role Management</h2>

    @Html.AntiForgeryToken()

    <div class="custom-card">
        <form method="get" asp-action="RoleList" asp-controller="Role" id="searchForm">
            <input type="hidden" name="pageNumber" value="1" />

            <div class="filter-container">
                <div class="filter-left-group">
                    <div class="search-input-group">
                        <input type="text" name="searchKeyword" class="form-control" placeholder="Search role by name or code.." value="@Model.SearchKeyword" />
                        <i class="bi bi-search search-icon"></i>
                    </div>

                    <select name="status" class="form-select custom-select">
                        <option value="">All Status</option>
                        <option value="1" selected="@(Model.Status == 1)">Active</option>
                        <option value="0" selected="@(Model.Status == 0)">Inactive</option>
                    </select>

                    <button type="submit" class="btn btn-search-menu">
                        <i class="bi bi-search me-1"></i> Search Role
                    </button>
                </div>

                <div>
                    <a asp-action="RoleEntry" asp-controller="Role" class="btn btn-add-role">
                        <i class="bi bi-plus-lg me-1"></i> Add New Role
                    </a>
                </div>
            </div>
        </form>
    </div>

    <div class="custom-card">
        <div class="table-responsive">
            <table class="role-table" style="table-layout: fixed; width: 100%;">
                <thead>
                    <tr>
                        <th style="width: 60px;">No.</th>
                        <th style="width: 140px;">Code</th>
                        <th style="width: 180px;">Role Name</th>
                        <th style="width: 250px;">Description</th>
                        <th style="width: 110px;">Status</th>
                        <th style="width: 110px; text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Roles != null && Model.Roles.Any())
                    {
                        int index = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                        foreach (var item in Model.Roles)
                        {
                            <tr>
                                <td>@(index++)</td>

                                <td class="fw-medium">
                                    <span class="table-text-truncate" title="@item.RoleCode">
                                        @item.RoleCode
                                    </span>
                                </td>

                                <td class="fw-semibold">
                                    <span class="table-text-truncate" title="@item.DisplayName">
                                        @item.DisplayName
                                    </span>
                                </td>

                                <td class="text-secondary">
                                    <span class="table-text-truncate" title="@item.Description">
                                        @(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)
                                    </span>
                                </td>

                                <td>
                                    @if (item.Status)
                                    {
                                        <span class="badge-status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status-inactive">Inactive</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <a asp-action="RoleEntry" asp-controller="Role" asp-route-code="@item.RoleCode"
                                       class="text-primary text-decoration-none mx-2 shadow-none"
                                       style="outline: none;" title="Edit Role">
                                        <i class="bi bi-pencil-square" style="font-size: 1.15rem;"></i>
                                    </a>

                                    <button type="button"
                                            class="text-danger border-0 bg-transparent p-0 mx-2 shadow-none"
                                            style="outline: none;"
                                            onclick="deleteRole('@item.RoleCode')" title="Delete Role">
                                        <i class="bi bi-trash" style="font-size: 1.15rem;"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer d-flex justify-content-between align-items-center mt-3">
            <div>
                @{
                    int startRecord = Model.TotalRecords == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize) + 1;
                    int endRecord = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords);
                }
                Showing @startRecord - @endRecord of @Model.TotalRecords records
            </div>

            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="RoleList"
                           asp-route-pageNumber="@(Model.PageNumber - 1)"
                           asp-route-searchKeyword="@Model.SearchKeyword"
                           asp-route-status="@Model.Status">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    @{
                        int totalPagesToShow = Model.TotalPages > 0 ? Model.TotalPages : 1;
                    }
                    @for (int i = 1; i <= totalPagesToShow; i++)
                    {
                        <li class="page-item @(i == (Model.PageNumber == 0 ? 1 : Model.PageNumber) ? "active" : "")">
                            <a class="page-link"
                               asp-action="RoleList"
                               asp-route-pageNumber="@i"
                               asp-route-searchKeyword="@Model.SearchKeyword"
                               asp-route-status="@Model.Status">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.PageNumber >= totalPagesToShow ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="RoleList"
                           asp-route-pageNumber="@(Model.PageNumber + 1)"
                           asp-route-searchKeyword="@Model.SearchKeyword"
                           asp-route-status="@Model.Status">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<partial name="AlertModal" />

@section Scripts {
    <script src="~/js/Alert_Modal.js" asp-append-version="true"></script>

    <script>
        function deleteRole(roleCode) {
            var deleteMessage = "Are you sure you want to delete this role?";

            showDelete(deleteMessage, function () {
                var token = $('input[name="__RequestVerificationToken"]').val();

                $('#alertModal').modal('hide');

                setTimeout(function () {
                    $.ajax({
                        url: '@Url.Action("DeleteRole", "Role")',
                        type: 'POST',
                        data: {
                            roleCode: roleCode,
                            __RequestVerificationToken: token
                        },
                        success: function (res) {
                            if (res.success) {
                                showSuccess(res.message || 'Role has been deleted successfully.');

                                $('#alertModal').one('hidden.bs.modal', function () {
                                    location.reload();
                                });
                            } else {
                                showError(res.message || 'Failed to delete the role.');
                            }
                        },
                        error: function (xhr, status, error) {
                            var errMsg = "A system error occurred: " + error;
                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                errMsg = xhr.responseJSON.message;
                            }
                            showError(errMsg);
                        }
                    });
                }, 350);
            });
        }
    </script>
}