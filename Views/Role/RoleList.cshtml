@model CKM_ManagementSystem.Models.ViewModels.RoleListPagedViewModel

@{
    ViewData["Title"] = "Role Management";
}

@section Styles {
    <link rel="stylesheet" href="~/css/role-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
}

<div class="container-fluid px-4 px-md-5 pb-5">
    <h2 class="page-title">Role Management</h2>

    @Html.AntiForgeryToken()

    <div class="custom-card">
        <form method="get" asp-action="RoleList" id="searchForm">
            <input type="hidden" name="pageNumber" value="1" />
            <div class="filter-container">
                <div class="filter-left-group">
                    <div class="search-input-group">
                        <input type="text" name="searchKeyword" class="form-control" placeholder="Search role by name or code.." value="@Model.SearchKeyword" />
                        <i class="bi bi-search search-icon"></i>
                    </div>

                    <select name="status" class="form-select custom-select">
                        <option value="">All Status</option>
                        <option value="1" selected="@(Model.Status == 1)">Active</option>
                        <option value="0" selected="@(Model.Status == 0)">Inactive</option>
                    </select>

                    <button type="submit" class="btn btn-search-menu">
                        <i class="bi bi-search me-1"></i> Search Role
                    </button>
                </div>

                <div>
                    <a asp-action="RoleEntry" class="btn btn-add-role">
                        <i class="bi bi-plus-lg me-1"></i> Add New Role
                    </a>
                </div>
            </div>
        </form>
    </div>

    <div class="custom-card">
        <div class="table-responsive">
            <table class="role-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">No.</th>
                        <th>Code</th>
                        <th>Role Name</th>
                        <th>Description</th>
                        <th style="width: 120px;">Status</th>
                        <th style="width: 120px; text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Roles != null && Model.Roles.Any())
                    {
                        int index = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                        foreach (var item in Model.Roles)
                        {
                            <tr>
                                <td>@(index++)</td>
                                <td class="fw-medium">@item.RoleCode</td>
                                <td class="fw-semibold">@item.DisplayName</td>
                                <td class="text-secondary">@item.Description</td>
                                <td>
                                    @if (item.Status)
                                    {
                                        <span class="badge-status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status-inactive">Inactive</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <a asp-action="RoleEntry" asp-route-code="@item.RoleCode"
                                       class="text-primary text-decoration-none mx-2 shadow-none"
                                       style="outline: none;" title="Edit">
                                        <i class="bi bi-pencil-square" style="font-size: 1.15rem;"></i>
                                    </a>

                                    <button type="button"
                                            class="text-danger border-0 bg-transparent p-0 mx-2 shadow-none"
                                            style="outline: none;"
                                            onclick="deleteRole('@item.RoleCode')" title="Delete">
                                        <i class="bi bi-trash" style="font-size: 1.15rem;"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer d-flex justify-content-between align-items-center mt-3">
            <div>
                @{
                    int startRecord = Model.TotalRecords == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize) + 1;
                    int endRecord = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords);
                }
                Showing @startRecord - @endRecord of @Model.TotalRecords records
            </div>

            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="RoleList" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-searchKeyword="@Model.SearchKeyword" asp-route-status="@Model.Status">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    @{
                        int totalPagesToShow = Model.TotalPages > 0 ? Model.TotalPages : 1;
                    }
                    @for (int i = 1; i <= totalPagesToShow; i++)
                    {
                        <li class="page-item @(i == (Model.PageNumber == 0 ? 1 : Model.PageNumber) ? "active" : "")">
                            <a class="page-link" asp-action="RoleList" asp-route-pageNumber="@i" asp-route-searchKeyword="@Model.SearchKeyword" asp-route-status="@Model.Status">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.PageNumber >= totalPagesToShow ? "disabled" : "")">
                        <a class="page-link" asp-action="RoleList" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-searchKeyword="@Model.SearchKeyword" asp-route-status="@Model.Status">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {

        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                        Swal.fire({
                            title: 'အောင်မြင်ပါသည်!',
                            text: '@Html.Raw(TempData["SuccessMessage"])',
                            icon: 'success',
                            confirmButtonColor: '#635bff',
                            timer: 2500
                        });
            </text>
        }
        });

        function deleteRole(roleCode) {
            Swal.fire({
                title: 'သေချာပါသလား?',
                text: "ဒီ Role ကို ဖျက်ပစ်ရန် သေချာပါသလား?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'ဖျက်ပါမည်',
                cancelButtonText: 'မဖျက်တော့ပါ'
            }).then((result) => {
                if (result.isConfirmed) {
                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '@Url.Action("DeleteRole", "Role")',
                        type: 'POST',
                        data: {
                            roleCode: roleCode,
                            __RequestVerificationToken: token
                        },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'ဖျက်ပြီးပါပြီ!',
                                    text: 'Role ကို အောင်မြင်စွာ ဖျက်ပြီးပါပြီ။',
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('မအောင်မြင်ပါ!', res.message || 'Role ကို ဖျက်၍ မရနိုင်ပါ။', 'error');
                            }
                        },
                        error: function (xhr, status, error) {
                            Swal.fire('အမှားအယွင်းရှိပါသည်!', 'စနစ်အတွင်း အမှားအယွင်းဖြစ်ပေါ်နေပါသည်: ' + error, 'error');
                        }
                    });
                }
            });
        }
    </script>
}