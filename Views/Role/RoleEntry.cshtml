@model CKM_ManagementSystem.Models.ViewModels.RoleEntryViewModel

@{
    ViewData["Title"] = "User Role Entry";
}

<!-- Bootstrap Icons & Custom CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/role-management.css" asp-append-version="true" />

<div class="container py-4">
    <div class="card custom-card border-0 p-4 mx-auto position-relative" style="max-width: 650px; background-color: #ffffff; border-radius: 12px;">

        <!-- ညာဘက်အပေါ်ထောင့် Close (X) Button (RoleList သို့ ပြန်ရောက်မည်) -->
        <a asp-action="RoleList" class="btn-close position-absolute top-0 end-0 m-4" aria-label="Close" title="Close"></a>

        <!-- Header (Centered Title) -->
        <h4 class="fw-bold text-dark text-center mb-4">User Role Entry</h4>

        <form asp-action="RoleEntry" method="post">

            <!-- Role Code -->
            <div class="mb-3">
                <label class="form-label text-secondary fw-semibold small">Role Code</label>
                <input asp-for="RoleCode" class="form-control" placeholder="e.g., role code" />
                <span asp-validation-for="RoleCode" class="text-danger small"></span>
            </div>

            <!-- Display Name -->
            <div class="mb-3">
                <label class="form-label text-secondary fw-semibold small">Display Name</label>
                <input asp-for="DisplayName" class="form-control" placeholder="e.g., Admin" />
                <span asp-validation-for="DisplayName" class="text-danger small"></span>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label class="form-label text-secondary fw-semibold small">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="e.g., Admin"></textarea>
            </div>

            <!-- Status -->
            <div class="mb-4 d-flex align-items-center">
                <label class="form-label text-secondary fw-semibold small mb-0 me-4">Status</label>
                <div class="form-check form-check-inline mb-0 me-3">
                    <input class="form-check-input" type="radio" asp-for="Status" value="true" id="statusActive" checked />
                    <label class="form-check-label fw-semibold small text-dark" for="statusActive">Active</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="radio" asp-for="Status" value="false" id="statusInactive" />
                    <label class="form-check-label fw-semibold small text-dark" for="statusInactive">Inactive</label>
                </div>
            </div>

            <!-- Menu Group Permissions Section -->
            <div class="mb-4">
                <label class="form-label text-secondary fw-semibold small">Menu Group Permissions</label>
                <div class="border rounded p-3 bg-light">
                    <div class="d-flex justify-content-between fw-semibold text-muted small border-bottom pb-2 mb-2">
                        <span>Menu Structure</span>
                        <span>Allowed Actions</span>
                    </div>
                    <!-- Dynamic Menu Tree Render လာမယ့်နေရာ -->
                </div>
            </div>

            <!-- Action Buttons (ုံထဲအတိုင်း Full Width / 2 Equal Columns) -->
            <div class="row g-2 pt-2">
                <div class="col-6">
                    <button type="reset" class="btn btn-secondary w-100 py-2 fw-semibold" style="background-color: #6c757d; border: none;">Clear</button>
                </div>
                <div class="col-6">
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold" style="background-color: #5850ec; border: none;">Register</button>
                </div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}