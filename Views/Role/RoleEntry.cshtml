@model CKM_ManagementSystem.Models.ViewModels.Roles.RoleEntryViewModel

@{
    ViewData["Title"] = "User Role Entry";
    bool isEditMode = Model != null && !string.IsNullOrEmpty(Model.RoleCode);
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/role-entry.css" asp-append-version="true" />

<div class="role-entry-container">
    <h2>@(isEditMode ? "Edit User Role" : "User Role Entry")</h2>

    <form asp-action="SaveRole" method="post" id="roleEntryForm">
        @Html.AntiForgeryToken()

        <div class="form-group mb-3">
            <label asp-for="RoleCode" class="form-label">Role Code</label>
            <input asp-for="RoleCode" class="form-control" readonly="@(isEditMode ? "readonly" : null)" />
            <span asp-validation-for="RoleCode" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="DisplayName" class="form-label">Display Name</label>
            <input asp-for="DisplayName" class="form-control" />
            <span asp-validation-for="DisplayName" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="Status" class="form-check-input" type="checkbox" />
            <label asp-for="Status" class="form-check-label">Is Active</label>
        </div>

        <h4>Menu Permissions</h4>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Menu Name</th>
                    <th>Read</th>
                    <th>Write</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.MenuPermissions != null)
                {
                    for (int i = 0; i < Model.MenuPermissions.Count; i++)
                    {
                        <tr>
                            <td>
                                @Html.HiddenFor(m => m.MenuPermissions[i].MenuId)
                                @Html.HiddenFor(m => m.MenuPermissions[i].MenuName)
                                @Model.MenuPermissions[i].MenuName
                            </td>
                            <td>@Html.CheckBoxFor(m => m.MenuPermissions[i].CanRead)</td>
                            <td>@Html.CheckBoxFor(m => m.MenuPermissions[i].CanWrite)</td>
                            <td>@Html.CheckBoxFor(m => m.MenuPermissions[i].CanDelete)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="RoleList" class="btn btn-secondary">Back to List</a>
    </form>
</div>