@model CKM_ManagementSystem.Models.ViewModels.Roles.RoleEntryViewModel
@{
    bool isEditMode = Model != null && (!string.IsNullOrEmpty(Model.RoleCode) || Model.IsEdit);
    ViewData["Title"] = isEditMode ? "Edit User Role" : "User Role Entry";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/role-entry.css" asp-append-version="true" />

<div class="container py-4">
    <div class="role-entry-card position-relative">

        <h2 class="role-entry-title">@(isEditMode ? "Edit User Role" : "User Role Entry")</h2>

        <form id="roleForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IsEdit" id="IsEdit" value="@(isEditMode ? "true" : "false")" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="mb-3">
                <label class="form-label-custom">Role Code</label>
                <input asp-for="RoleCode" id="RoleCode" class="form-control" placeholder="e.g., role code" maxlength="20" autofocus readonly="@(isEditMode ? "readonly" : null)" />
                <span asp-validation-for="RoleCode" id="valRoleCode" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label-custom">Display Name</label>
                <input asp-for="DisplayName" id="DisplayName" class="form-control" placeholder="e.g., Admin" maxlength="50" />
                <span asp-validation-for="DisplayName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label-custom">Description</label>
                <textarea asp-for="Description" id="Description" class="form-control" rows="3" placeholder="e.g., Description..." maxlength="250"></textarea>
            </div>

            <div class="mb-4 d-flex align-items-center">
                <label class="form-label-custom mb-0 me-4">Status</label>
                <div class="form-check form-check-inline mb-0 me-3">
                    <input class="form-check-input" type="radio" asp-for="Status" value="true" id="statusActive" checked="@(Model?.Status ?? true)" />
                    <label class="form-check-label fw-semibold small text-dark" for="statusActive">Active</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="radio" asp-for="Status" value="false" id="statusInactive" checked="@(Model?.Status == false)" />
                    <label class="form-check-label fw-semibold small text-dark" for="statusInactive">Inactive</label>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label-custom">Menu Group Permissions</label>

                <div class="permissions-table-wrapper">
                    <table class="table permissions-table mb-0 align-middle">
                        <thead>
                            <tr>
                                <th style="padding-left: 1.5rem;">Menu Structure</th>
                                <th class="text-center" style="width: 250px;">Allowed Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.MenuPermissions != null && Model.MenuPermissions.Count > 0)
                            {
                                var rootMenus = Model.MenuPermissions
                                .Where(m => !m.ParentId.HasValue || m.ParentId == 0)
                                .ToList();

                                foreach (var root in rootMenus)
                                {
                                    int rootIndex = Model.MenuPermissions.IndexOf(root);
                                    var children = Model.MenuPermissions
                                    .Where(m => m.ParentId == root.MenuId)
                                    .ToList();

                                    <tr class="parent-menu-row fw-bold" data-menu-id="@root.MenuId" data-parent-id="0">
                                        <input type="hidden" name="MenuPermissions[@rootIndex].MenuId" value="@root.MenuId" />
                                        <input type="hidden" name="MenuPermissions[@rootIndex].MenuName" value="@root.MenuName" />
                                        <input type="hidden" name="MenuPermissions[@rootIndex].ParentId" value="@root.ParentId" />

                                        <td style="padding-left: 1.5rem;">
                                            <span class="fw-bold text-dark">@root.MenuName</span>
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-center gap-3">
                                                <div class="form-check form-check-inline mb-0 me-0">
                                                    <input class="form-check-input chk-read" type="checkbox" name="MenuPermissions[@rootIndex].CanRead" value="true" id="read_@rootIndex" @(root.CanRead ? "checked" : "") />
                                                    <label class="form-check-label small" for="read_@rootIndex">Read</label>
                                                </div>
                                                <div class="form-check form-check-inline mb-0 me-0">
                                                    <input class="form-check-input chk-write" type="checkbox" name="MenuPermissions[@rootIndex].CanWrite" value="true" id="write_@rootIndex" @(root.CanWrite ? "checked" : "") />
                                                    <label class="form-check-label small" for="write_@rootIndex">Write</label>
                                                </div>
                                                <div class="form-check form-check-inline mb-0 me-0">
                                                    <input class="form-check-input chk-delete" type="checkbox" name="MenuPermissions[@rootIndex].CanDelete" value="true" id="delete_@rootIndex" @(root.CanDelete ? "checked" : "") />
                                                    <label class="form-check-label small" for="delete_@rootIndex">Delete</label>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>

                                    for (int c = 0; c < children.Count; c++)
                                    {
                                        var child = children[c];
                                        int childIndex = Model.MenuPermissions.IndexOf(child);
                                        bool isLastChild = (c == children.Count - 1);

                                        <tr class="child-menu-row" data-menu-id="@child.MenuId" data-parent-id="@root.MenuId">
                                            <input type="hidden" name="MenuPermissions[@childIndex].MenuId" value="@child.MenuId" />
                                            <input type="hidden" name="MenuPermissions[@childIndex].MenuName" value="@child.MenuName" />
                                            <input type="hidden" name="MenuPermissions[@childIndex].ParentId" value="@child.ParentId" />

                                            <td style="padding-left: 1.5rem;">
                                                <span class="text-muted me-2 font-monospace ms-3">@(isLastChild ? "└─" : "├─")</span>
                                                <span class="text-secondary">@child.MenuName</span>
                                            </td>
                                            <td>
                                                <div class="d-flex justify-content-center gap-3">
                                                    <div class="form-check form-check-inline mb-0 me-0">
                                                        <input class="form-check-input chk-read" type="checkbox" name="MenuPermissions[@childIndex].CanRead" value="true" id="read_@childIndex" @(child.CanRead ? "checked" : "") />
                                                        <label class="form-check-label small" for="read_@childIndex">Read</label>
                                                    </div>
                                                    <div class="form-check form-check-inline mb-0 me-0">
                                                        <input class="form-check-input chk-write" type="checkbox" name="MenuPermissions[@childIndex].CanWrite" value="true" id="write_@childIndex" @(child.CanWrite ? "checked" : "") />
                                                        <label class="form-check-label small" for="write_@childIndex">Write</label>
                                                    </div>
                                                    <div class="form-check form-check-inline mb-0 me-0">
                                                        <input class="form-check-input chk-delete" type="checkbox" name="MenuPermissions[@childIndex].CanDelete" value="true" id="delete_@childIndex" @(child.CanDelete ? "checked" : "") />
                                                        <label class="form-check-label small" for="delete_@childIndex">Delete</label>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-center text-muted py-3">
                                        No menu permissions available.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row g-2 pt-2">
                <div class="col-6">
                    @if (isEditMode)
                    {
                        <a href="@Url.Action("RoleList", "Role")" class="btn btn-outline-secondary w-100 py-2 text-center text-decoration-none">
                            Cancel
                        </a>
                    }
                    else
                    {
                        <button type="button" id="btnClear" class="btn btn-outline-secondary w-100 py-2">
                            Clear
                        </button>
                    }
                </div>
                <div class="col-6">
                    <button type="submit" id="btnRegister" class="btn btn-register w-100 py-2">
                        @(isEditMode ? "Update" : "Register")
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {

            var isEditMode = @isEditMode.ToString().ToLower();

            if (!isEditMode) {
                $('#RoleCode').focus();
            }

            $(document).on('input keyup paste', '#RoleCode', function () {
                var $this = $(this);
                setTimeout(function () {
                    var cleanValue = $this.val().replace(/[^a-zA-Z0-9_-]/g, '');
                    $this.val(cleanValue);
                }, 0);
            });

            $('#roleForm').on('keydown', function (e) {
                if (e.key === 'Enter' || e.keyCode === 13) {
                    var targetNode = e.target.nodeName.toLowerCase();
                    if (targetNode !== 'textarea') {
                        e.preventDefault();

                        if (e.target.id === 'RoleCode') {
                            $('#DisplayName').focus();
                        } else if (e.target.id === 'DisplayName') {
                            $('#Description').focus();
                        }
                        return false;
                    }
                }
            });

            var $form = $("#roleForm");
            if ($form.data('validator')) {
                var validator = $form.data('validator');
                validator.settings.onfocusout = false;
                validator.settings.onkeyup = false;
            }

            $(document).on('blur', '#RoleCode', function () {
                var roleCodeVal = $(this).val();
                var $valSpan = $('#valRoleCode');

                if (roleCodeVal && !isEditMode) {
                    $.post('/Role/CheckDuplicateCode', { roleCode: roleCodeVal }, function (res) {
                        if (res.isDuplicate) {
                            $valSpan.text('This Role Code already exists.');
                        } else {
                            if ($valSpan.text() === 'This Role Code already exists.') {
                                $valSpan.text('');
                            }
                        }
                    });
                }
            });

            $(document).on('change', '.parent-menu-row input[type="checkbox"]', function () {
                var $parentRow = $(this).closest('tr');
                var parentId = $parentRow.data('menu-id');
                var isChecked = $(this).is(':checked');

                var actionType = '';
                if ($(this).hasClass('chk-read')) actionType = '.chk-read';
                else if ($(this).hasClass('chk-write')) actionType = '.chk-write';
                else if ($(this).hasClass('chk-delete')) actionType = '.chk-delete';

                if (actionType !== '') {
                    $('tr.child-menu-row[data-parent-id="' + parentId + '"]')
                        .find(actionType)
                        .prop('checked', isChecked);
                }
            });

            $(document).on('change', '.child-menu-row input[type="checkbox"]', function () {
                var $childRow = $(this).closest('tr');
                var parentId = $childRow.data('parent-id');

                var actionType = '';
                if ($(this).hasClass('chk-read')) actionType = '.chk-read';
                else if ($(this).hasClass('chk-write')) actionType = '.chk-write';
                else if ($(this).hasClass('chk-delete')) actionType = '.chk-delete';

                if (actionType !== '') {
                    var anyChecked = $('tr.child-menu-row[data-parent-id="' + parentId + '"]')
                                        .find(actionType + ':checked').length > 0;

                    $('tr.parent-menu-row[data-menu-id="' + parentId + '"]')
                        .find(actionType)
                        .prop('checked', anyChecked);
                }
            });

            $('#btnClear').on('click', function () {
                $('#roleForm')[0].reset();
                $('span.text-danger').text('');
                $('#statusActive').prop('checked', true);
                $('.permissions-table input[type="checkbox"]').prop('checked', false);
                $('#RoleCode').focus();
            });

            $('#roleForm').on('submit', function (e) {
                e.preventDefault();

                if (!$(this).valid()) return;

                if ($('#valRoleCode').text() === 'This Role Code already exists.') {
                    return;
                }

                $('#btnRegister').prop('disabled', true);

                let formData = $(this).serializeArray();
                formData.push({ name: "isEdit", value: isEditMode });
                formData.push({ name: "IsEdit", value: isEditMode });

                $.ajax({
                    url: '/Role/SaveRole',
                    type: 'POST',
                    data: $.param(formData),
                    success: function (response) {
                        $('#btnRegister').prop('disabled', false);

                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: response.message || 'Operation completed successfully.',
                                confirmButtonText: 'OK'
                            }).then((result) => {
                                if (isEditMode) {
                                    window.location.href = '/Role/RoleList';
                                } else {
                                    $('#btnClear').trigger('click');
                                }
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Saving failed.'
                            });
                        }
                    },
                    error: function () {
                        $('#btnRegister').prop('disabled', false);
                        Swal.fire({
                            icon: 'error',
                            title: 'System Error',
                            text: 'An error occurred while processing your request.'
                        });
                    }
                });
            });

        });
    </script>
}