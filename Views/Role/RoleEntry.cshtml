@model CKM_ManagementSystem.Models.ViewModels.Roles.RoleEntryViewModel
@{
    bool isEditMode = Model != null && (!string.IsNullOrEmpty(Model.RoleCode) || Model.IsEdit);
    ViewData["Title"] = isEditMode ? "Edit User Role" : "User Role Entry";
}

@section Styles {
    <link rel="stylesheet" href="~/css/role-entry.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Alert_Modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}

<div class="container py-4">
    <div class="role-entry-card">
        <h2 class="role-entry-title">@(isEditMode ? "Edit User Role" : "User Role Entry")</h2>

        <form id="roleForm" action="@Url.Action("SaveRole", "Role")" method="post" onsubmit="return false;">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IsEdit" id="IsEdit" value="@(isEditMode ? "true" : "false")" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small" id="generalError"></div>

            <div class="mb-3">
                <label class="form-label-custom" for="RoleCode">Role Code</label>
                <input asp-for="RoleCode" id="RoleCode" class="form-control" placeholder="e.g., MM" maxlength="20" autofocus readonly="@(isEditMode ? "readonly" : null)" />
                <span asp-validation-for="RoleCode" id="valRoleCode" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label-custom" for="DisplayName">Display Name</label>
                <input asp-for="DisplayName" id="DisplayName" class="form-control" placeholder="e.g., Admin" maxlength="50" />
                <span asp-validation-for="DisplayName" id="valDisplayName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label-custom" for="Description">Description</label>
                <textarea asp-for="Description" id="Description" class="form-control" rows="3" placeholder="e.g., Description..." maxlength="250"></textarea>
                <span asp-validation-for="Description" id="valDescription" class="text-danger small"></span>
            </div>

            <div class="mb-4 d-flex align-items-center">
                <label class="form-label-custom mb-0 me-4">Status</label>
                <div class="form-check form-check-inline mb-0 me-3">
                    <input class="form-check-input" type="radio" asp-for="Status" value="true" id="statusActive" checked="@(Model?.Status ?? true)" />
                    <label class="form-check-label fw-semibold small text-dark" for="statusActive">Active</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="radio" asp-for="Status" value="false" id="statusInactive" checked="@(Model?.Status == false)" />
                    <label class="form-check-label fw-semibold small text-dark" for="statusInactive">Inactive</label>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label-custom mb-2">Menu Group Permissions</label>

                <div class="table-responsive permissions-table-wrapper border rounded">
                    <table class="table align-middle mb-0 permissions-table">
                        <thead class="bg-light sticky-top">
                            <tr>
                                <th style="padding-left: 1.5rem;" class="text-secondary small fw-bold">Menu Structure</th>
                                <th class="text-end text-secondary small fw-bold" style="padding-right: 2.5rem; min-width: 260px;">Allowed Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.MenuPermissions != null && Model.MenuPermissions.Count > 0)
                            {
                                var rootMenus = Model.MenuPermissions
                                    .Where(m => !m.ParentId.HasValue || m.ParentId == 0)
                                    .ToList();

                                foreach (var root in rootMenus)
                                {
                                    int rootIndex = Model.MenuPermissions.IndexOf(root);
                                    var children = Model.MenuPermissions
                                        .Where(m => m.ParentId == root.MenuId)
                                        .ToList();

                                    <tr class="parent-menu-row fw-bold table-light" data-menu-id="@root.MenuId" data-parent-id="0">
                                        <td style="padding-left: 1.5rem;">
                                            <input type="hidden" name="MenuPermissions[@rootIndex].MenuId" value="@root.MenuId" />
                                            <input type="hidden" name="MenuPermissions[@rootIndex].MenuName" value="@root.MenuName" />
                                            <input type="hidden" name="MenuPermissions[@rootIndex].ParentId" value="@root.ParentId" />
                                            <span class="fw-bold text-dark ps-2">@root.MenuName</span>
                                        </td>
                                        <td class="text-end" style="padding-right: 2.5rem;">
                                            <div class="d-inline-flex justify-content-end align-items-center">
                                                <div class="form-check form-check-inline mb-0 me-0 text-start" style="width: 75px;">
                                                    <input class="form-check-input chk-read" type="checkbox" name="MenuPermissions[@rootIndex].CanRead" value="true" id="read_@rootIndex" @(root.CanRead ? "checked" : "") />
                                                    <input type="hidden" name="MenuPermissions[@rootIndex].CanRead" value="false" />
                                                    <label class="form-check-label fw-bold small ms-1" for="read_@rootIndex">Read</label>
                                                </div>
                                                <div class="form-check form-check-inline mb-0 me-0 text-start" style="width: 75px;">
                                                    <input class="form-check-input chk-write" type="checkbox" name="MenuPermissions[@rootIndex].CanWrite" value="true" id="write_@rootIndex" @(root.CanWrite ? "checked" : "") />
                                                    <input type="hidden" name="MenuPermissions[@rootIndex].CanWrite" value="false" />
                                                    <label class="form-check-label fw-bold small ms-1" for="write_@rootIndex">Write</label>
                                                </div>
                                                <div class="form-check form-check-inline mb-0 me-0 text-start" style="width: 75px;">
                                                    <input class="form-check-input chk-delete" type="checkbox" name="MenuPermissions[@rootIndex].CanDelete" value="true" id="delete_@rootIndex" @(root.CanDelete ? "checked" : "") />
                                                    <input type="hidden" name="MenuPermissions[@rootIndex].CanDelete" value="false" />
                                                    <label class="form-check-label fw-bold small ms-1" for="delete_@rootIndex">Delete</label>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>

                                    for (int c = 0; c < children.Count; c++)
                                    {
                                        var child = children[c];
                                        int childIndex = Model.MenuPermissions.IndexOf(child);
                                        bool isLastChild = (c == children.Count - 1);

                                        <tr class="child-menu-row" data-menu-id="@child.MenuId" data-parent-id="@root.MenuId">
                                            <td style="padding-left: 3.0rem;">
                                                <input type="hidden" name="MenuPermissions[@childIndex].MenuId" value="@child.MenuId" />
                                                <input type="hidden" name="MenuPermissions[@childIndex].MenuName" value="@child.MenuName" />
                                                <input type="hidden" name="MenuPermissions[@childIndex].ParentId" value="@child.ParentId" />
                                                <span class="text-muted me-2 font-monospace">@(isLastChild ? "└─" : "├─")</span>
                                                <span class="text-secondary">@child.MenuName</span>
                                            </td>
                                            <td class="text-end" style="padding-right: 2.5rem;">
                                                <div class="d-inline-flex justify-content-end align-items-center">
                                                    <div class="form-check form-check-inline mb-0 me-0 text-start" style="width: 75px;">
                                                        <input class="form-check-input chk-read" type="checkbox" name="MenuPermissions[@childIndex].CanRead" value="true" id="read_@childIndex" @(child.CanRead ? "checked" : "") />
                                                        <input type="hidden" name="MenuPermissions[@childIndex].CanRead" value="false" />
                                                        <label class="form-check-label small ms-1" for="read_@childIndex">Read</label>
                                                    </div>
                                                    <div class="form-check form-check-inline mb-0 me-0 text-start" style="width: 75px;">
                                                        <input class="form-check-input chk-write" type="checkbox" name="MenuPermissions[@childIndex].CanWrite" value="true" id="write_@childIndex" @(child.CanWrite ? "checked" : "") />
                                                        <input type="hidden" name="MenuPermissions[@childIndex].CanWrite" value="false" />
                                                        <label class="form-check-label small ms-1" for="write_@childIndex">Write</label>
                                                    </div>
                                                    <div class="form-check form-check-inline mb-0 me-0 text-start" style="width: 75px;">
                                                        <input class="form-check-input chk-delete" type="checkbox" name="MenuPermissions[@childIndex].CanDelete" value="true" id="delete_@childIndex" @(child.CanDelete ? "checked" : "") />
                                                        <input type="hidden" name="MenuPermissions[@childIndex].CanDelete" value="false" />
                                                        <label class="form-check-label small ms-1" for="delete_@childIndex">Delete</label>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-center text-muted py-3">
                                        No menu permissions available.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row g-2 pt-2">
                <div class="col-6">
                    @if (isEditMode)
                    {
                        <a href="@Url.Action("RoleList", "Role")" class="btn btn-outline-secondary w-100 py-2 text-center text-decoration-none">
                            Cancel
                        </a>
                    }
                    else
                    {
                        <button type="button" id="btnClear" class="btn btn-outline-secondary w-100 py-2">
                            Clear
                        </button>
                    }
                </div>
                <div class="col-6">
                    <button type="button" id="btnRegister" class="btn btn-primary w-100 py-2">
                        @(isEditMode ? "Update" : "Register")
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<partial name="AlertModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Alert_Modal.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            const isEditMode = @Html.Raw(Json.Serialize(isEditMode));
            let initialFormData = '';
            let pendingAction = null;

            if (!isEditMode) {
                $('#RoleCode').focus();
            } else {
                initialFormData = $('#roleForm').serialize();
            }

            function clearValidationErrors() {
                $('span.text-danger').text('');
                $('#generalError').text('');
            }

            function getActionClass($checkbox) {
                if ($checkbox.hasClass('chk-read')) return '.chk-read';
                if ($checkbox.hasClass('chk-write')) return '.chk-write';
                if ($checkbox.hasClass('chk-delete')) return '.chk-delete';
                return '';
            }

            // Read, Write, Delete checkbox dependency handler
            $(document).on('change', '.chk-write, .chk-delete', function () {
                if ($(this).is(':checked')) {
                    $(this).closest('tr').find('.chk-read').prop('checked', true);
                }
            });

            $(document).on('change', '.chk-read', function () {
                if (!$(this).is(':checked')) {
                    $(this).closest('tr').find('.chk-write, .chk-delete').prop('checked', false);
                }
            });

            // Parent Menu Checkbox Cascade Handler
            $(document).on('change', '.parent-menu-row input[type="checkbox"]', function () {
                const $parentRow = $(this).closest('tr');
                const parentId = $parentRow.data('menu-id');
                const isChecked = $(this).is(':checked');
                const actionClass = getActionClass($(this));
                const $children = $(`tr.child-menu-row[data-parent-id="${parentId}"]`);

                if (actionClass === '.chk-read') {
                    if (isChecked) {
                        $children.find('.chk-read').prop('checked', true);
                    } else {
                        $parentRow.find('.chk-write, .chk-delete').prop('checked', false);
                        $children.find('input[type="checkbox"]').prop('checked', false);
                    }
                } else if (actionClass) {
                    $children.find(actionClass).prop('checked', isChecked);
                    if (isChecked) {
                        $parentRow.find('.chk-read').prop('checked', true);
                        $children.find('.chk-read').prop('checked', true);
                    }
                }
            });

            // Child Menu Checkbox Cascade Handler
            $(document).on('change', '.child-menu-row input[type="checkbox"]', function () {
                const $childRow = $(this).closest('tr');
                const parentId = $childRow.data('parent-id');
                const actionClass = getActionClass($(this));

                if (actionClass) {
                    const $totalChildren = $(`tr.child-menu-row[data-parent-id="${parentId}"]`);
                    const $checkedChildren = $totalChildren.find(`${actionClass}:checked`);
                    const $parentRow = $(`tr.parent-menu-row[data-menu-id="${parentId}"]`);

                    if (actionClass === '.chk-read') {
                        if ($(this).is(':checked')) {
                            $parentRow.find('.chk-read').prop('checked', true);
                        } else if ($checkedChildren.length === 0) {
                            $parentRow.find('.chk-read').prop('checked', false);
                        }
                    } else {
                        const allChecked = ($totalChildren.length === $checkedChildren.length && $totalChildren.length > 0);
                        $parentRow.find(actionClass).prop('checked', allChecked);

                        if ($(this).is(':checked')) {
                            $childRow.find('.chk-read').prop('checked', true);
                            $parentRow.find('.chk-read').prop('checked', true);
                        }
                    }
                }
            });

            $('#alertModal').on('hidden.bs.modal', function () {
                if (pendingAction) {
                    pendingAction();
                    pendingAction = null;
                }
            });

            // Input Sanitization
            $('#RoleCode').on('input keyup paste change', function () {
                var val = $(this).val();
                var clean = val.replace(/[^a-zA-Z0-9_-]/g, '');
                if (val !== clean) {
                    $(this).val(clean);
                }
            });

            $('#DisplayName, #Description').on('input keyup paste change', function () {
                var val = $(this).val();
                var clean = val.replace(/[<>'";&]/g, '');
                if (val !== clean) {
                    $(this).val(clean);
                }
            });

            $('#RoleCode, #DisplayName, #Description').on('input', function () {
                var fieldId = $(this).attr('id');
                $('[data-valmsg-for="' + fieldId + '"]').text('');
            });

            // Enter key navigation
            $('#roleForm input, #roleForm textarea').on('keydown', function (e) {
                if (e.key === 'Enter' || e.keyCode === 13) {
                    if ($(this).is(':checkbox') || $(this).is(':radio')) return;

                    e.preventDefault();
                    const inputs = $(this).closest('form').find('input:enabled:not([readonly]), textarea:enabled:not([readonly])');
                    const index = inputs.index(this);

                    if (index >= 0 && index < inputs.length - 1) {
                        inputs.eq(index + 1).focus();
                    }
                }
            });

            // Clear Button Handler
            $('#btnClear').on('click', function () {
                const $form = $('#roleForm');
                $form[0].reset();
                clearValidationErrors();
                $('#statusActive').prop('checked', true);
                $('.permissions-table input[type="checkbox"]').prop('checked', false);
                if (!isEditMode) {
                    $('#RoleCode').focus();
                } else {
                    $('#DisplayName').focus();
                }
            });

            // Form Submission
            $('#btnRegister').on('click', function (e) {
                e.preventDefault();
                executeSubmit();
            });

            function executeSubmit() {
                clearValidationErrors();
                var $form = $('#roleForm');

                if (isEditMode) {
                    var currentFormData = $form.serialize();
                    if (initialFormData === currentFormData) {
                        window.location.href = '@Url.Action("RoleList", "Role")';
                        return;
                    }
                }

                $('#btnRegister').prop('disabled', true);

                $.ajax({
                    url: $form.attr('action'),
                    type: 'POST',
                    data: $form.serialize(),
                    success: function (response) {
                        $('#btnRegister').prop('disabled', false);

                        if (response.success) {
                            const message = response.message || (isEditMode ? "Role updated successfully." : "Registration is complete.");

                            pendingAction = function () {
                                if (response.isEdit || isEditMode) {
                                    window.location.href = response.redirectUrl || '@Url.Action("RoleList", "Role")';
                                } else {
                                    $('#btnClear').click();
                                }
                            };

                            showSuccess(message);
                        } else {
                            if (response.errors && typeof response.errors === 'object') {
                                $.each(response.errors, function (key, message) {
                                    $('[data-valmsg-for="' + key + '"]').text(message);
                                });
                            } else if (response.message) {
                                showError(response.message);
                            }
                        }
                    },
                    error: function () {
                        $('#btnRegister').prop('disabled', false);
                        showError('An error occurred while processing your request.');
                    }
                });
            }
        });
    </script>
}