@model CKM_ManagementSystem.Models.ViewModels.Roles.RoleEntryViewModel

@{
    ViewData["Title"] = "User Role Entry";
    bool isEditMode = Model != null && !string.IsNullOrEmpty(Model.RoleCode);
}

@section Styles {
    <link rel="stylesheet" href="~/css/role-entry.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Alert_Modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}

<div class="container py-4">
    <div class="role-entry-card">
        <h4 class="role-entry-title">User Role Entry</h4>

        <form id="roleForm" method="post" asp-action="RoleEntry" asp-controller="Role">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="mb-3">
                <label class="form-label-custom">Role Code</label>
                <input asp-for="RoleCode" id="RoleCode" class="form-control" placeholder="e.g., MM" maxlength="20" autofocus readonly="@(isEditMode ? "readonly" : null)" />
                <span asp-validation-for="RoleCode" id="valRoleCode" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label-custom">Display Name</label>
                <input asp-for="DisplayName" id="DisplayName" class="form-control" placeholder="e.g., Admin" maxlength="50" />
                <span asp-validation-for="DisplayName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label-custom">Description</label>

                <textarea asp-for="Description" id="Description" class="form-control" rows="3" placeholder="e.g., Description..." maxlength="250"></textarea>
            </div>

            <div class="mb-4 d-flex align-items-center">
                <label class="form-label-custom mb-0 me-4">Status</label>
                <div class="form-check form-check-inline mb-0 me-3">
                    <input class="form-check-input" type="radio" asp-for="Status" value="true" id="statusActive" checked="@(Model?.Status ?? true)" />
                    <label class="form-check-label fw-semibold small text-dark" for="statusActive">Active</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="radio" asp-for="Status" value="false" id="statusInactive" checked="@(Model?.Status == false)" />
                    <label class="form-check-label fw-semibold small text-dark" for="statusInactive">Inactive</label>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label-custom mb-2">Menu Group Permissions</label>

                <div class="table-responsive permissions-table-wrapper border rounded">
                    <table class="table align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th style="padding-left: 1.5rem;" class="text-secondary small fw-bold">Menu Structure</th>
                                <th class="text-end text-secondary small fw-bold" style="padding-right: 2.5rem; min-width: 260px;">Allowed Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.MenuPermissions != null && Model.MenuPermissions.Count > 0)
                            {
                                for (int i = 0; i < Model.MenuPermissions.Count; i++)
                                {
                                    var currentMenu = Model.MenuPermissions[i];
                                    int level = currentMenu.Level; // Dynamic Hierarchy Level
                                    bool isParent = level == 0;

                                    // Check if this menu is the last item in its child group
                                    bool isLastSubmenu = false;
                                    if (!isParent)
                                    {
                                        bool hasNextChild = false;
                                        for (int j = i + 1; j < Model.MenuPermissions.Count; j++)
                                        {
                                            var nextMenu = Model.MenuPermissions[j];
                                            if (nextMenu.Level < level) break;
                                            if (nextMenu.ParentId == currentMenu.ParentId)
                                            {
                                                hasNextChild = true;
                                                break;
                                            }
                                        }
                                        isLastSubmenu = !hasNextChild;
                                    }

                                    double paddingLeftRem = 1.5 + (level * 1.5);

                                    <tr class="@(isParent ? "parent-menu-row table-light" : "child-menu-row")"
                                        data-menu-id="@currentMenu.MenuId"
                                        data-parent-id="@(currentMenu.ParentId ?? 0)"
                                        data-level="@level">

                                        <input type="hidden" asp-for="MenuPermissions[i].MenuId" />
                                        <input type="hidden" asp-for="MenuPermissions[i].MenuName" />
                                        <input type="hidden" asp-for="MenuPermissions[i].ParentId" />
                                        <input type="hidden" asp-for="MenuPermissions[i].Level" />

                                        <td style="padding-left: @(paddingLeftRem.ToString("0.0"))rem;">
                                            @if (isParent)
                                            {
                                                <span class="parent-menu-title fw-bold text-dark">
                                                    @currentMenu.MenuName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="tree-icon text-muted me-2 fw-bold">@(isLastSubmenu ? "└──" : "├──")</span>
                                                <span class="child-menu-title text-secondary">@currentMenu.MenuName</span>
                                            }
                                        </td>

                                        <td class="text-end" style="padding-right: 2.5rem;">
                                            <div class="d-inline-flex justify-content-end align-items-center">
                                                <div class="form-check form-check-inline mb-0 me-0 text-start" style="width: 75px;">
                                                    <input class="form-check-input chk-read" type="checkbox" asp-for="MenuPermissions[i].CanRead" id="read_@i">
                                                    <label class="form-check-label @(isParent ? "fw-bold" : "") small ms-1" for="read_@i">Read</label>
                                                </div>
                                                <div class="form-check form-check-inline mb-0 me-0 text-start" style="width: 75px;">
                                                    <input class="form-check-input chk-write" type="checkbox" asp-for="MenuPermissions[i].CanWrite" id="write_@i">
                                                    <label class="form-check-label @(isParent ? "fw-bold" : "") small ms-1" for="write_@i">Write</label>
                                                </div>
                                                <div class="form-check form-check-inline mb-0 me-0 text-start" style="width: 75px;">
                                                    <input class="form-check-input chk-delete" type="checkbox" asp-for="MenuPermissions[i].CanDelete" id="delete_@i">
                                                    <label class="form-check-label @(isParent ? "fw-bold" : "") small ms-1" for="delete_@i">Delete</label>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-center text-muted py-3">
                                        No menu permissions available.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row g-2 pt-2">
                <div class="col-6">
                    @if (isEditMode)
                    {
                        <a href="@Url.Action("RoleList", "Role")" class="btn btn-outline-secondary w-100 py-2 text-center text-decoration-none">
                            Cancel
                        </a>
                    }
                    else
                    {
                        <button type="button" id="btnClear" class="btn btn-outline-secondary w-100 py-2">
                            Clear
                        </button>
                    }
                </div>
                <div class="col-6">
                    <button type="submit" id="btnRegister" class="btn btn-primary w-100 py-2">
                        @(isEditMode ? "Update" : "Register")
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<partial name="AlertModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Alert_Modal.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            const isEditMode = @isEditMode.ToString().ToLower();

            if (!isEditMode) {
                $('#RoleCode').focus();
            }

          
            $(document).on('change', '.chk-write, .chk-delete', function () {
                if ($(this).is(':checked')) {
                    $(this).closest('td').find('.chk-read').prop('checked', true).trigger('change');
                }
            });

            
            $(document).on('change', '.chk-read', function () {
                if (!$(this).is(':checked')) {
                    $(this).closest('td').find('.chk-write, .chk-delete').prop('checked', false);
                }
            });

            
            $('#roleForm').on('submit', function (e) {
                const $form = $(this);
                if (!$form.valid()) return;

                e.preventDefault();

                $.ajax({
                    url: $form.attr('action'),
                    type: 'POST',
                    data: $form.serialize(),
                    success: function (response) {
                        if (response.success) {
                            showSuccess(response.message);
                            $('#alertModal').one('hidden.bs.modal', function () {
                                if (isEditMode) {
                                    window.location.href = '@Url.Action("RoleList", "Role")';
                                } else {
                                    $('#btnClear').click();
                                }
                            });
                        } else {
                            showError(response.message);
                        }
                    },
                    error: function () {
                        showError('An error occurred while saving.');
                    }
                });
            });

            
            $('#roleForm input, #roleForm textarea').on('keydown', function (e) {
                if (e.key === 'Enter' || e.keyCode === 13) {
                    if ($(this).is(':checkbox') || $(this).is(':radio')) return;

                    e.preventDefault();
                    const inputs = $(this).closest('form').find('input:enabled:not([readonly]), textarea:enabled:not([readonly])');
                    const index = inputs.index(this);

                    if (index >= 0 && index < inputs.length - 1) {
                        inputs.eq(index + 1).focus();
                    }
                }
            });

            
            $(document).on('input keyup paste', '#RoleCode', function () {
                const $this = $(this);
                setTimeout(function () {
                    const cleanValue = $this.val().replace(/[^a-zA-Z0-9_-]/g, '');
                    $this.val(cleanValue);
                }, 0);
            });

            
            $(document).on('change', '.parent-menu-row input[type="checkbox"]', function () {
                const $parentRow = $(this).closest('tr');
                const parentId = $parentRow.data('menu-id');
                const isChecked = $(this).is(':checked');

                const actionClass = getActionClass($(this));

                if (actionClass) {
                    $(`tr.child-menu-row[data-parent-id="${parentId}"]`)
                        .find(actionClass)
                        .prop('checked', isChecked);

                    if (actionClass !== '.chk-read' && isChecked) {
                        $parentRow.find('.chk-read').prop('checked', true);
                        $(`tr.child-menu-row[data-parent-id="${parentId}"]`).find('.chk-read').prop('checked', true);
                    }
                }
            });

           
            $(document).on('change', '.child-menu-row input[type="checkbox"]', function () {
                const $childRow = $(this).closest('tr');
                const parentId = $childRow.data('parent-id');

                const actionClass = getActionClass($(this));

                if (actionClass) {
                    const $totalChildren = $(`tr.child-menu-row[data-parent-id="${parentId}"]`);
                    const $checkedChildren = $totalChildren.find(`${actionClass}:checked`);
                    const allChecked = ($totalChildren.length === $checkedChildren.length);

                    $(`tr.parent-menu-row[data-menu-id="${parentId}"]`)
                        .find(actionClass)
                        .prop('checked', allChecked);
                }
            });

            
            function getActionClass($el) {
                if ($el.hasClass('chk-read')) return '.chk-read';
                if ($el.hasClass('chk-write')) return '.chk-write';
                if ($el.hasClass('chk-delete')) return '.chk-delete';
                return '';
            }

            
            $('#btnClear').on('click', function () {
                const $form = $('#roleForm');
                $form[0].reset();
                $form.find('.field-validation-error').empty().addClass('field-validation-valid').removeClass('field-validation-error');
                $form.find('.input-validation-error').removeClass('input-validation-error');
                $('#statusActive').prop('checked', true);
                $('#RoleCode').focus();
            });
        });
    </script>
}