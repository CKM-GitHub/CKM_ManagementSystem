@model CKM_ManagementSystem.Models.ViewModels.Roles.RoleEntryViewModel

@{
    ViewData["Title"] = "User Role Entry";
    
    bool isEditMode = Model != null && !string.IsNullOrEmpty(Model.RoleCode);
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/role-entry.css" asp-append-version="true" />

<div class="container py-4">
    <div class="role-entry-card position-relative">

        <h2 class="role-entry-title">User Role Entry</h2>

        <form id="roleForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="mb-3">
                <label class="form-label-custom">Role Code</label>
                <input asp-for="RoleCode" id="RoleCode" class="form-control" placeholder="e.g., role code" maxlength="20" autofocus readonly="@(isEditMode ? "readonly" : null)" />
                <span asp-validation-for="RoleCode" id="valRoleCode" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label-custom">Display Name</label>
                <input asp-for="DisplayName" id="DisplayName" class="form-control" placeholder="e.g., Admin" maxlength="50" />
                <span asp-validation-for="DisplayName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label-custom">Description</label>
                <textarea asp-for="Description" id="Description" class="form-control" rows="3" placeholder="e.g., Description..." maxlength="250"></textarea>
            </div>

            <div class="mb-4 d-flex align-items-center">
                <label class="form-label-custom mb-0 me-4">Status</label>
                <div class="form-check form-check-inline mb-0 me-3">
                    <input class="form-check-input" type="radio" asp-for="Status" value="true" id="statusActive" checked />
                    <label class="form-check-label fw-semibold small text-dark" for="statusActive">Active</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="radio" asp-for="Status" value="false" id="statusInactive" />
                    <label class="form-check-label fw-semibold small text-dark" for="statusInactive">Inactive</label>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label-custom">Menu Group Permissions</label>

                <div class="permissions-table-wrapper">
                    <table class="table permissions-table mb-0 align-middle">
                        <thead>
                            <tr>
                                <th style="padding-left: 1.5rem;">Menu Structure</th>
                                <th class="text-center" style="width: 250px;">Allowed Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.MenuPermissions != null && Model.MenuPermissions.Count > 0)
                            {
                                for (int i = 0; i < Model.MenuPermissions.Count; i++)
                                {
                                    bool isParent = Model.MenuPermissions[i].ParentId == null;

                                    bool isLastSubmenu = false;
                                    if (!isParent)
                                    {
                                        var currentParentId = Model.MenuPermissions[i].ParentId;
                                        isLastSubmenu = (i == Model.MenuPermissions.Count - 1) ||
                                        (Model.MenuPermissions[i + 1].ParentId != currentParentId);
                                    }

                                    <tr class="@(isParent ? "parent-menu-row" : "child-menu-row")"
                                        data-menu-id="@Model.MenuPermissions[i].MenuId"
                                        data-parent-id="@Model.MenuPermissions[i].ParentId">

                                        <input type="hidden" name="MenuPermissions[@i].MenuId" value="@Model.MenuPermissions[i].MenuId" />
                                        <input type="hidden" name="MenuPermissions[@i].MenuName" value="@Model.MenuPermissions[i].MenuName" />
                                        <input type="hidden" name="MenuPermissions[@i].ParentId" value="@Model.MenuPermissions[i].ParentId" />

                                        <td style="padding-left: 1.5rem;">
                                            @if (isParent)
                                            {
                                                <span class="fw-bold text-dark">@Model.MenuPermissions[i].MenuName</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted me-2 font-monospace">@(isLastSubmenu ? "└─" : "├─")</span>
                                                <span class="text-secondary">@Model.MenuPermissions[i].MenuName</span>
                                            }
                                        </td>

                                        <td>
                                            <div class="d-flex justify-content-center gap-3">
                                                <div class="form-check form-check-inline mb-0 me-0">
                                                    <input class="form-check-input chk-read" type="checkbox" asp-for="MenuPermissions[i].CanRead" id="read_@i">
                                                    <label class="form-check-label small" for="read_@i">Read</label>
                                                </div>
                                                <div class="form-check form-check-inline mb-0 me-0">
                                                    <input class="form-check-input chk-write" type="checkbox" asp-for="MenuPermissions[i].CanWrite" id="write_@i">
                                                    <label class="form-check-label small" for="write_@i">Write</label>
                                                </div>
                                                <div class="form-check form-check-inline mb-0 me-0">
                                                    <input class="form-check-input chk-delete" type="checkbox" asp-for="MenuPermissions[i].CanDelete" id="delete_@i">
                                                    <label class="form-check-label small" for="delete_@i">Delete</label>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-center text-muted py-3">
                                        No menu permissions available.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row g-2 pt-2">
                <div class="col-6">
                    @if (isEditMode)
                    {
                        
                        <a href="@Url.Action("RoleList", "Role")" class="btn btn-outline-secondary w-100 py-2 text-center text-decoration-none">
                            Cancel
                        </a>
                    }
                    else
                    {
                        
                        <button type="button" id="btnClear" class="btn btn-outline-secondary w-100 py-2">
                            Clear
                        </button>
                    }
                </div>
                <div class="col-6">
                    <button type="submit" id="btnRegister" class="btn btn-register w-100 py-2">
                        @(isEditMode ? "Update" : "Register")
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {

            $('#RoleCode').focus();


                   $('#RoleCode').on('blur', function () {
            var roleCodeVal = $(this).val();
            var $valSpan = $('#valRoleCode');

            if (roleCodeVal && !@isEditMode.ToString().ToLower()) {
                $.post('/Role/CheckDuplicateCode', { roleCode: roleCodeVal }, function (res) {
                    if (res.isDuplicate) {
                        $valSpan.text('This Role Code already exists.');
                    } else {
                        if ($valSpan.text() === 'This Role Code already exists.') {
                            $valSpan.text('');
                        }
                    }
                });
            }
        });

           
            $('.parent-menu-row input[type="checkbox"]').on('change', function () {
                var $parentRow = $(this).closest('tr');
                var parentId = $parentRow.data('menu-id');
                var isChecked = $(this).is(':checked');

                var actionType = '';
                if ($(this).hasClass('chk-read')) actionType = '.chk-read';
                else if ($(this).hasClass('chk-write')) actionType = '.chk-write';
                else if ($(this).hasClass('chk-delete')) actionType = '.chk-delete';

                if (actionType !== '') {
                    $('tr.child-menu-row[data-parent-id="' + parentId + '"]')
                        .find(actionType)
                        .prop('checked', isChecked);
                }
            });

            $('.child-menu-row input[type="checkbox"]').on('change', function () {
                var $childRow = $(this).closest('tr');
                var parentId = $childRow.data('parent-id');

                var actionType = '';
                if ($(this).hasClass('chk-read')) actionType = '.chk-read';
                else if ($(this).hasClass('chk-write')) actionType = '.chk-write';
                else if ($(this).hasClass('chk-delete')) actionType = '.chk-delete';

                if (actionType !== '') {
                    var anyChecked = $('tr.child-menu-row[data-parent-id="' + parentId + '"]')
                                        .find(actionType + ':checked').length > 0;

                    $('tr.parent-menu-row[data-menu-id="' + parentId + '"]')
                        .find(actionType)
                        .prop('checked', anyChecked);
                }
            });

           
            $('#btnClear').on('click', function () {
                $('#roleForm')[0].reset();
                $('span.text-danger').text('');
                $('#statusActive').prop('checked', true);
                $('#RoleCode').focus();
            });

           
            $('#roleForm').on('submit', function (e) {
                e.preventDefault();

                if (!$(this).valid()) return;

                let formData = $(this).serialize();

                $('#btnRegister').prop('disabled', true);

                $.ajax({
                    url: '/Role/SaveRole',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        $('#btnRegister').prop('disabled', false);

                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: 'Registration is complete.',
                                confirmButtonText: 'OK'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    window.location.href = '/Role/RoleList';
                                }
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Saving failed.'
                            });
                        }
                    },
                    error: function () {
                        $('#btnRegister').prop('disabled', false);
                        Swal.fire({
                            icon: 'error',
                            title: 'System Error',
                            text: 'An error occurred while processing your request.'
                        });
                    }
                });
            });

        });
    </script>
}