@model CKM_ManagementSystem.Models.ViewModels.RoleEntryViewModel

@{
    bool isEditMode = ViewBag.IsEditMode ?? false;
    ViewData["Title"] = isEditMode ? "Edit User Role" : "User Role Entry";
}

@section Styles {
    <link rel="stylesheet" href="~/css/role-entry.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
}

<div class="container py-3">
    <div class="role-entry-card">
        <h3 class="role-entry-title">@(isEditMode ? "Edit User Role" : "User Role Entry")</h3>

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <form id="roleForm" asp-action="SaveRole" method="post">
            <div class="mb-3">
                <label class="form-label form-label-custom">Role Code <span class="text-danger">*</span></label>
                <input type="text" asp-for="RoleCode" id="RoleCode" class="form-control" placeholder="e.g., role code" autocomplete="off" readonly="@(isEditMode ? "readonly" : null)" />
                <span id="roleCodeError" class="text-danger small ms-1"></span>
            </div>

            <div class="mb-3">
                <label class="form-label form-label-custom">Display Name <span class="text-danger">*</span></label>
                <input type="text" asp-for="DisplayName" id="DisplayName" class="form-control" placeholder="e.g., Admin" />
                <span id="displayNameError" class="text-danger small ms-1"></span>
            </div>

            <div class="mb-3">
                <label class="form-label form-label-custom">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="e.g., Admin"></textarea>
            </div>

            <div class="mb-3 d-flex align-items-center gap-4">
                <label class="form-label form-label-custom mb-0">Status</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Status" value="true" id="statusActive">
                    <label class="form-check-label" for="statusActive">Active</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Status" value="false" id="statusInactive">
                    <label class="form-check-label" for="statusInactive">Inactive</label>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label form-label-custom mb-2">Menu Group Permissions</label>
                <div class="table-responsive permissions-table-wrapper">
                    <table class="table table-hover align-middle permissions-table mb-0">
                        <thead>
                            <tr>
                                <th style="width: 45%;">Menu Structure</th>
                                <th class="text-center" style="width: 55%;">Allowed Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.MenuPermissions != null)
                            {
                                @for (int i = 0; i < Model.MenuPermissions.Count; i++)
                                {
                                    var isSub = Model.MenuPermissions[i].ParentId.HasValue;
                                    var currentMenuId = Model.MenuPermissions[i].MenuId;
                                    var parentId = Model.MenuPermissions[i].ParentId;

                                    <tr class="@(!isSub ? "parent-menu-row" : "sub-menu-row")"
                                        data-menu-id="@currentMenuId"
                                        data-parent-id="@(parentId.HasValue ? parentId.Value : 0)">

                                        <td>
                                            <input type="hidden" asp-for="MenuPermissions[i].MenuId" />
                                            <input type="hidden" asp-for="MenuPermissions[i].MenuName" />
                                            <input type="hidden" asp-for="MenuPermissions[i].ParentId" />

                                            <span class="@(isSub ? "submenu-indent" : "")">
                                                @(isSub ? "├─ " + Model.MenuPermissions[i].MenuName : Model.MenuPermissions[i].MenuName)
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-around">
                                                <div class="form-check">
                                                    <input class="form-check-input chk-read" type="checkbox" asp-for="MenuPermissions[i].CanRead" />
                                                    <label class="form-check-label">Read</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input chk-write" type="checkbox" asp-for="MenuPermissions[i].CanWrite" />
                                                    <label class="form-check-label">Write</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input chk-delete" type="checkbox" asp-for="MenuPermissions[i].CanDelete" />
                                                    <label class="form-check-label">Delete</label>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row g-2">
                <div class="col-6">
                    <a asp-action="RoleList" class="btn btn-clear w-100 text-center text-decoration-none">Cancel</a>
                </div>
                <div class="col-6">
                    <button type="submit" class="btn btn-register w-100">@(isEditMode ? "Update" : "Register")</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            var isEditMode = @(isEditMode.ToString().ToLower());

            if (!isEditMode) {
                $('#RoleCode').focus();
            }

            
        @if (TempData["SuccessMessage"] != null)
        {
            @:Swal.fire({
            @:    title: 'အောင်မြင်ပါသည်!',
            @:    text: '@Html.Raw(TempData["SuccessMessage"])',
            @:    icon: 'success',
            @:    confirmButtonColor: '#635bff',
            @:    timer: 2500
            @:});
        }

            $('#RoleCode').on('blur', function () {
                if (isEditMode) return;

                var code = $(this).val().trim();
                if (code !== '') {
                    $.post('/Role/CheckDuplicateCode', { roleCode: code }, function (res) {
                        if (res.isDuplicate) {
                            $('#roleCodeError').text('ဒီ Role Code က အသုံးပြုပြီးသား ဖြစ်နေပါသည်။');
                        } else {
                            $('#roleCodeError').text('');
                        }
                    });
                } else {
                    $('#roleCodeError').text('');
                }
            });

            $('#roleForm').on('submit', function (e) {
                var isValid = true;

                var roleCode = $('#RoleCode').val().trim();
                var displayName = $('#DisplayName').val().trim();

                if (roleCode === '') {
                    $('#roleCodeError').text('Role Code ဖြည့်ရန် လိုအပ်ပါသည်။');
                    isValid = false;
                }

                if (displayName === '') {
                    $('#displayNameError').text('Display Name ဖြည့်ရန် လိုအပ်ပါသည်။');
                    isValid = false;
                }

                if ($('#roleCodeError').text() !== '') {
                    isValid = false;
                }

                if (!isValid) {
                    e.preventDefault();
                }
            });

            $(document).on('change', '.parent-menu-row input[type="checkbox"]', function () {
                var $parentTr = $(this).closest('tr');
                var parentMenuId = $parentTr.data('menu-id');
                var isChecked = $(this).prop('checked');
                var colIndex = $(this).closest('.form-check').index();

                $('tr[data-parent-id="' + parentMenuId + '"]').each(function () {
                    $(this).find('.form-check').eq(colIndex).find('input[type="checkbox"]').prop('checked', isChecked);
                });
            });

            $(document).on('change', '.sub-menu-row input[type="checkbox"]', function () {
                var $subTr = $(this).closest('tr');
                var parentId = $subTr.data('parent-id');
                var colIndex = $(this).closest('.form-check').index();

                var $parentRow = $('tr[data-menu-id="' + parentId + '"]');
                var $parentCheckbox = $parentRow.find('.form-check').eq(colIndex).find('input[type="checkbox"]');

                var checkedSub = $('tr[data-parent-id="' + parentId + '"]').filter(function () {
                    return $(this).find('.form-check').eq(colIndex).find('input[type="checkbox"]').is(':checked');
                }).length;

                $parentCheckbox.prop('checked', checkedSub > 0);
            });
        });
    </script>
}