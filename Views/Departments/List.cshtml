@using CKM_ManagementSystem.Models.ViewModels.Departments
@model DepartmentListViewModel

@{
    Layout = null;
    ViewData["Title"] = "Department Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/DepartmentList.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>

    <div class="department-list-page">

        <h2 class="department-list-title">
            Department Management
        </h2>

        <form asp-controller="Departments"
              asp-action="Index"
              method="get"
              class="search-section">

            <div class="search-left">

                <input type="text"
                       name="searchText"
                       value="@Model.SearchText"
                       class="form-control search-input"
                       placeholder="Search department by name or code" />

                <select name="status"
                        class="form-select status-select">

                    <option value="">
                        All Status
                    </option>

                    <option value="true"
                            selected="@(Model.Status == true)">
                        Active
                    </option>

                    <option value="false"
                            selected="@(Model.Status == false)">
                        Inactive
                    </option>

                </select>

                <button type="submit"
                        class="btn-search">
                    Search Department
                </button>

            </div>

            <div class="search-right">

                <a asp-controller="Departments"
                   asp-action="Entry"
                   class="btn-add">
                    + Add Department
                </a>

            </div>

        </form>

        <div class="table-card">

            <div class="table-responsive">

                <table class="table department-table">

                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Department Code</th>
                            <th>Department Name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    @{
                        int rowNumber =
                        ((Model.PageNumber - 1) * Model.PageSize) + 1;
                    }

                    <tbody>

                        @if (Model.Departments.Count == 0)
                        {
                            <tr>
                                <td colspan="6"
                                    class="no-records">
                                    No departments found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var department in Model.Departments)
                            {
                                <tr>
                                    <td>@rowNumber</td>

                                    <td>
                                        @department.DepartmentCode
                                    </td>

                                    <td>
                                        @department.DepartmentName
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(
                                            department.Description)
                                            ? "-"
                                            : department.Description)
                                    </td>

                                    <td>
                                        <span class="status-badge @(department.Status
                                            ? "status-active"
                                            : "status-inactive")">

                                            @(department.Status
                                                ? "Active"
                                                : "Inactive")

                                        </span>
                                    </td>

                                    <td class="action-column">

                                        <a asp-controller="Departments"
                                           asp-action="Edit"
                                           asp-route-departmentCode="@department.DepartmentCode"
                                           class="icon-button edit-icon"
                                           title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <button type="button"
                                                class="icon-button delete-icon"
                                                data-department-code="@department.DepartmentCode"
                                                title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </td>
                                </tr>

                                rowNumber++;
                            }
                        }

                    </tbody>

                </table>

            </div>

            <div class="table-footer">

                <div class="record-summary">

                    @if (Model.TotalRecords > 0)
                    {
                        int startRecord =
                        ((Model.PageNumber - 1) * Model.PageSize) + 1;

                        int endRecord =
                        Math.Min(
                        Model.PageNumber * Model.PageSize,
                        Model.TotalRecords);

                        <span>
                            Showing
                            <strong>@startRecord–@endRecord</strong>
                            of
                            <strong>@Model.TotalRecords</strong>
                            Departments
                        </span>
                    }
                    else
                    {
                        <span>
                            Showing 0 Departments
                        </span>
                    }

                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="pagination-container"
                         aria-label="Department list pagination">

                        <ul class="pagination">

                            <li class="page-item @(Model.PageNumber == 1
                                ? "disabled"
                                : "")">

                                <a class="page-link"
                                   asp-controller="Departments"
                                   asp-action="Index"
                                   asp-route-searchText="@Model.SearchText"
                                   asp-route-status="@Model.Status"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)">
                                    ‹
                                </a>

                            </li>

                            @for (
                           int pageNo = 1;
                           pageNo <= Model.TotalPages;
                           pageNo++)
                            {
                                <li class="page-item @(pageNo == Model.PageNumber
                                    ? "active"
                                    : "")">

                                    <a class="page-link"
                                       asp-controller="Departments"
                                       asp-action="Index"
                                       asp-route-searchText="@Model.SearchText"
                                       asp-route-status="@Model.Status"
                                       asp-route-pageNumber="@pageNo">
                                        @pageNo
                                    </a>

                                </li>
                            }

                            <li class="page-item @(Model.PageNumber == Model.TotalPages
                                ? "disabled"
                                : "")">

                                <a class="page-link"
                                   asp-controller="Departments"
                                   asp-action="Index"
                                   asp-route-searchText="@Model.SearchText"
                                   asp-route-status="@Model.Status"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)">
                                    ›
                                </a>

                            </li>

                        </ul>

                    </nav>
                }

            </div>

        </div>
        <div class="modal fade" id="deleteDepartmentModal" 
            tabindex="-1" aria-labelledby="deleteDepartmentModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteDepartmentModalLabel">
                            Delete Department
                        </h5>

                        <button type="button" 
                        class="btn-close" data-bs-dismiss="modal" 
                        aria-label="Close">

                        </button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to delete this department?
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                           No
                        </button>

                        <button type="button" class="btn btn-danger" 
                            id="confirmDeleteDepartment">
                            Yes, Delete
                        </button>


                    </div>
                </div>
            </div>

        </div>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="modal fade"
                 id="successModal"
                 tabindex="-1"
                 aria-labelledby="successModalLabel"
                 aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title"
                                id="successModalLabel">
                                Success
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close">
                            </button>
                        </div>

                        <div class="modal-body">
                            @TempData["SuccessMessage"]
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-primary"
                                    data-bs-dismiss="modal">
                                OK
                            </button>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mt-3"
             role="alert">
            @TempData["ErrorMessage"]
        </div>
    }
    <form asp-controller="Departments" asp-action="Delete" method="post" id="deleteDepartmentForm" class="d-none">
     @Html.AntiForgeryToken()
     <input type="hidden" name="departmentCode" id="deleteDepartmentCode" />
    </form>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/DepartmentList.js" asp-append-version="true"></script>
</body>
</html>