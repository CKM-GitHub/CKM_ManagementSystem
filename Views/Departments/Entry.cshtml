@using CKM_ManagementSystem.Models.ViewModels.Departments
@model DepartmentEntryViewModel

@{
    Layout = null;
    ViewData["Title"] = "Department Entry";
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/Department_Entry.css" />
</head>

<body>

    <div class="department-entry-page">

        <div class="department-entry-card">

            <h2 class="department-entry-title">
                Department Entry
            </h2>
            
            <form asp-controller="Departments"
                  asp-action="@(string.IsNullOrWhiteSpace(Model.OriginalDepartmentCode)
                     ?"Entry":"Edit")" 
                  method="post"
                  id="departmentEntryForm">
                  <input type="hidden" asp-for="OriginalDepartmentCode" />

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>

                <div class="form-group">

                    <label asp-for="DepartmentCode"></label>

                    <input asp-for="DepartmentCode"
                           id="departmentCode"
                           class="form-control"
                           autocomplete="off" 
                           readonly="@(!string.IsNullOrWhiteSpace(Model.OriginalDepartmentCode))"/>

                    <span asp-validation-for="DepartmentCode"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="DepartmentName"></label>

                    <input asp-for="DepartmentName"
                           class="form-control"
                           autocomplete="off" />

                    <span asp-validation-for="DepartmentName"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="Description"></label>

                    <textarea asp-for="Description"
                              class="form-control description-box">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="validation-message">
                    </span>

                </div>

                <div class="status-row">

                    <label class="status-title">
                        Status
                    </label>

                    <div class="status-options">

                        <label class="radio-label">

                            <input type="radio"
                                   asp-for="Status"
                                   value="true" />

                            Active

                        </label>

                        <label class="radio-label">

                            <input type="radio"
                                   asp-for="Status"
                                   value="false" />

                            Inactive

                        </label>

                    </div>

                </div>

                <div class="button-row">

                    @if (string.IsNullOrWhiteSpace(Model.OriginalDepartmentCode))
                    {
                        <button type="button"
                                class="btn-clear"
                                id="btnClear">
                            Clear
                        </button>

                        <button type="submit"
                                class="btn-register">
                            Register
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn-clear"
                                 onclick="window.location.href='@Url.Action("Index", "Departments")'">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn-register">
                            Update
                        </button>
                    }

                </div>
            </form>
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="modal fade"
                     id="successModal"
                     tabindex="-1"
                     aria-labelledby="successModalLabel"
                     aria-hidden="true">

                    <div class="modal-dialog modal-dialog-centered">

                        <div class="modal-content">

                            <div class="modal-header">

                                <h5 class="modal-title"
                                    id="successModalLabel">
                                    Success
                                </h5>

                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"
                                        aria-label="Close">
                                </button>

                            </div>

                            <div class="modal-body">
                                @TempData["SuccessMessage"]
                            </div>

                            <div class="modal-footer">

                                <button type="button"
                                        class="btn btn-primary"
                                        data-bs-dismiss="modal">
                                    OK
                                </button>

                            </div>

                        </div>

                    </div>

                </div>
            }
        </div>

    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/Department_Entry.js"
            asp-append-version="true">
    </script>

</body>
</html>