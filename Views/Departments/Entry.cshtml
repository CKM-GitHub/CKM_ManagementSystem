@using CKM_ManagementSystem.Models.ViewModels.Departments
@model DepartmentEntryViewModel

@{
    Layout = null;
    ViewData["Title"] = "Department Entry";
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/Department_Entry.css" />
</head>

<body>

    <div class="department-entry-page">

        <div class="department-entry-card">

            <h2 class="department-entry-title">
                Department Entry
            </h2>
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }
            <form asp-controller="Department"
                  asp-action="Entry"
                  method="post"
                  id="departmentEntryForm">

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>

                <div class="form-group">

                    <label asp-for="DepartmentCode"></label>

                    <input asp-for="DepartmentCode"
                           id="departmentCode"
                           class="form-control"
                           autocomplete="off" />

                    <span asp-validation-for="DepartmentCode"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="DepartmentName"></label>

                    <input asp-for="DepartmentName"
                           class="form-control"
                           autocomplete="off" />

                    <span asp-validation-for="DepartmentName"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="Description"></label>

                    <textarea asp-for="Description"
                              class="form-control description-box">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="validation-message">
                    </span>

                </div>

                <div class="status-row">

                    <label class="status-title">
                        Status
                    </label>

                    <div class="status-options">

                        <label class="radio-label">

                            <input type="radio"
                                   asp-for="Status"
                                   value="true" />

                            Active

                        </label>

                        <label class="radio-label">

                            <input type="radio"
                                   asp-for="Status"
                                   value="false" />

                            Inactive

                        </label>

                    </div>

                </div>

                <div class="button-row">

                    <button type="button" class="btn-clear" id="btnClear">Clear </button>
                    <button type="submit"
                            class="btn-register">
                        Register
                    </button>

                </div>

            </form>

        </div>

    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/Department_Entry.js"
            asp-append-version="true">
    </script>

</body>
</html>