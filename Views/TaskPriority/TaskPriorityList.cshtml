@using CKM_ManagementSystem.Models.ViewModels.TaskPriorities
@using CKM_ManagementSystem.Models.ViewModels.Common
@model TaskPriorityListViewModel
@{
    ViewData["Title"] = "Task Priority Management";
    int currentPage = Model.PagedData.PageNumber;
    int pageSize = Model.PagedData.PageSize;
    int totalItems = Model.PagedData.TotalCount;
    int startItem = totalItems > 0 ? (currentPage - 1) * pageSize + 1 : 0;
    int endItem = totalItems > 0 ? Math.Min(currentPage * pageSize, totalItems) : 0;
    int totalPages = Model.PagedData.TotalPages;
}
@section Styles {
    <link rel="stylesheet" href="~/css/TaskPriorityList.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Font.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/Alert_Modal.js" asp-append-version="true"></script>
    <script src="~/js/TaskPriority.js" asp-append-version="true"></script>
}

<div class="main-wrapper">

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <input type="hidden" id="successMessage" value="@successMessage" />
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <input type="hidden" id="errorMessage" value="@errorMessage" />
    }
    <partial name="AlertModal" />

<h1 class="page-title text-center">Task Priority Management</h1>  
    <div class="card custom-card">
        <div class="card-body p-4 d-flex flex-column h-100">
            <div class="toolbar d-flex flex-wrap align-items-center gap-2 mb-4">
                <form method="get" class="search-form d-flex gap-2 flex-grow-1" asp-controller="TaskPriority" asp-action="TaskPriorityList">
                    <div class="search-box flex-grow-1" style="max-width: 380px;">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text"
                                   name="Search"
                                   class="form-control search-input border-start-0"
                                   value="@Model.Search"
                                   placeholder="Search task priority by name or code"
                                   id="searchInput">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-search">
                        <i class="bi bi-search me-1"></i> Search
                    </button>

                    <input type="hidden" name="PageNumber" value="1" />
                    <input type="hidden" name="PageSize" value="@pageSize" />
                </form>

                <button id="createPriorityBtn"
                        type="button"
                        class="btn btn-primary btn-add ms-auto"
                        data-bs-toggle="modal"
                        data-bs-target="#taskPriorityModal">
                    <i class="bi bi-plus-lg me-1"></i> Add New Task Priority
                </button>
            </div>

            <div class="table-wrapper table-responsive">
                @if (Model.PagedData.Data != null && Model.PagedData.Data.Any())
                {
                    <table class="table align-middle custom-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3" style="width:70px">No.</th>
                                <th style="width:120px">Code</th>
                                <th style="width:180px">Name</th>
                                <th>Description</th>
                                <th class="text-center" style="width:110px">Sort Order</th>
                                <th class="text-end pe-3" style="width:120px">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int index = startItem;
                            }
                            @foreach (var priority in Model.PagedData.Data)
                            {
                                <tr>
                                    <td class="ps-3">@index</td>
                                    <td>@priority.Priority_Code</td>
                                    <td>@priority.Priority_Name</td>
                                    <td class="text-muted text-truncate"
                                        style="max-width: 300px;"
                                        title="@(string.IsNullOrWhiteSpace(priority.Description) ? "No description" : priority.Description)">
                                        @(string.IsNullOrWhiteSpace(priority.Description) ? "-" : priority.Description)
                                    </td>
                                    <td class="text-center">@priority.SortOrder</td>
                                    <td class="pe-3">
                                        <div class="action-buttons justify-content-end">
                                            <button type="button"
                                                    class="action-icon-btn edit-icon update-priority-btn"
                                                    title="Edit"
                                                    data-priority-code="@priority.Priority_Code"
                                                    data-priority-name="@priority.Priority_Name"
                                                    data-description="@(priority.Description ?? "")"
                                                    data-sort-order="@priority.SortOrder"
                                                    data-update-url="@Url.Action("UpdatePriority", "TaskPriority")"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#taskPriorityModal">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                            <form asp-controller="TaskPriority"
                                                  asp-action="DeletePriorityList"
                                                  method="post"
                                                  class="delete-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="Priority_Code" value="@priority.Priority_Code" />
                                                <button type="button" class="action-icon-btn delete-icon" title="Delete">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="d-flex flex-column align-items-center justify-content-center text-muted border rounded bg-light" style="height: 300px;">
                        <i class="bi bi-inbox mb-3 opacity-50" style="font-size: 4rem;"></i>
                        <p class="mb-0 fw-semibold fs-4">No Task Priorities found</p>
                    </div>
                }
            </div>

            @if (totalItems > 0)
            {
                <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                    <span class="text-muted small">
                        Showing @startItem-@endItem of @totalItems task priorities
                    </span>

                    @if (totalPages > 1)
                    {
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("TaskPriorityList", new { PageNumber = currentPage - 1, PageSize = pageSize, Search = Model.Search })">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>

                                @for (int p = 1; p <= totalPages; p++)
                                {
                                    <li class="page-item @(p == currentPage ? "active" : "")">
                                        <a class="page-link"
                                           href="@Url.Action("TaskPriorityList", new { PageNumber = p, PageSize = pageSize, Search = Model.Search })">
                                            @p
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("TaskPriorityList", new { PageNumber = currentPage + 1, PageSize = pageSize, Search = Model.Search })">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            }
        </div>
    </div>

    <div class="modal fade" id="taskPriorityModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content custom-modal">
                <div class="modal-header border-0 pb-0">
                    <!-- HTML Tag ပြင်ဆင်ထားသောနေရာ -->
                    <h1 class="modal-title fw-bold" id="createTaskPriorityModalLabel">
                        @(Model.Entry.Mode == "Edit" ? "Edit Task Priority" : "Add New Task Priority")
                    </h1>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body pt-3">
                    <form id="taskPriorityForm"
                          asp-controller="TaskPriority"
                          asp-action="@(Model.Entry.Mode == "Entry" ? "CreatePriority" : "UpdatePriority")"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="Entry.Mode" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="Entry.Priority_Code"
                                   class="form-label fw-semibold small">
                                Code <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Entry.Priority_Code"
                                   id="Code"
                                   class="form-control custom-input"
                                   placeholder="e.g., LOW, MEDIUM" />

                            <span asp-validation-for="Entry.Priority_Code"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Entry.Priority_Name"
                                   class="form-label fw-semibold small">
                                Name <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Entry.Priority_Name"
                                   id="Name"
                                   class="form-control custom-input"
                                   placeholder="e.g., Low Priority" />

                            <span asp-validation-for="Entry.Priority_Name"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Entry.Description"
                                   class="form-label fw-semibold small">
                                Description
                            </label>

                            <textarea asp-for="Entry.Description"
                                      id="Description"
                                      class="form-control custom-input"
                                      rows="3"
                                      placeholder="Enter description..."></textarea>

                            <span asp-validation-for="Entry.Description"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Entry.SortOrder"
                                   class="form-label fw-semibold small">
                                Sort Order <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Entry.SortOrder"
                                   type="number"
                                   id="SortOrder"
                                   class="form-control custom-input"
                                   placeholder="e.g., 1" />

                            <span asp-validation-for="Entry.SortOrder"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-light" onclick="window.location.href='@Url.Action("TaskPriorityList", "TaskPriority")'">
                                Cancel
                            </button>
                            <button type="submit" class="btn btn-primary btn-add">
                                @(Model.Entry.Mode == "Edit" ? "Update Priority" : "Save Priority")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (ViewBag.OpenPriorityModal == true)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const modalElement = document.getElementById("taskPriorityModal");

                if (modalElement) {
                    bootstrap.Modal.getOrCreateInstance(modalElement).show();
                }
            });
        </script>
    }
</div>